  {/*
    Invitación al Libro de visitas. Aparece una sola vez en la vida del
    navegador, tras cinco minutos de lectura acumulada, y nunca en el propio
    libro. No es un modal: no bloquea la página ni roba el foco.
  */}
  <aside id="invitacion-libro" hidden aria-labelledby="invitacion-titulo">
    <button type="button" id="cerrar-invitacion" aria-label="Cerrar la invitación">×</button>
    <p class="etiqueta">Libro de visitas</p>
    <p id="invitacion-titulo">¿Le has dejado ya un recuerdo?</p>
    <p class="cuerpo-invitacion">Si conociste a Tomás, si la lectura te ha traído algo, o si tienes una fotografía, hay un libro esperando tu firma.</p>
    <a href="/libro-de-visitas">Ver el libro</a>
  </aside>

  <script>
    (() => {
      const CLAVE_VISTA = 'memorias-invitacion-libro-v1';
      const CLAVE_TIEMPO = 'memorias-tiempo-lectura-v1';
      const UMBRAL = 5 * 60 * 1000;
      const tarjeta = document.getElementById('invitacion-libro');
      if (!tarjeta) return;
      // En el propio libro la invitación no tiene sentido.
      if (location.pathname.startsWith('/libro-de-visitas')) return;
      try {
        if (localStorage.getItem(CLAVE_VISTA)) return;
      } catch {
        return; // Sin almacenamiento no podemos garantizar que salga una sola vez.
      }

      const leer = () => {
        try { return Number(localStorage.getItem(CLAVE_TIEMPO) || 0) || 0; } catch { return 0; }
      };
      let acumulado = leer();
      let desde = Date.now();
      let temporizador;

      const guardar = () => {
        acumulado += Date.now() - desde;
        desde = Date.now();
        try { localStorage.setItem(CLAVE_TIEMPO, String(acumulado)); } catch {}
      };

      const mostrar = () => {
        try { localStorage.setItem(CLAVE_VISTA, '1'); } catch {}
        tarjeta.hidden = false;
        // Con setTimeout y no requestAnimationFrame: si la pestaña no está
        // componiendo, rAF no llega a ejecutarse y la tarjeta se quedaría
        // invisible para siempre, ya habiendo gastado su única aparición.
        setTimeout(() => tarjeta.classList.add('visible'), 30);
      };

      const programar = () => {
        clearTimeout(temporizador);
        const restante = UMBRAL - acumulado;
        if (restante <= 0) { mostrar(); return; }
        temporizador = setTimeout(() => { guardar(); mostrar(); }, restante);
      };

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) { guardar(); clearTimeout(temporizador); }
        else { desde = Date.now(); programar(); }
      });
      addEventListener('pagehide', guardar);
      programar();

      const cerrar = () => {
        tarjeta.classList.remove('visible');
        setTimeout(() => { tarjeta.hidden = true; }, 320);
      };
      document.getElementById('cerrar-invitacion')?.addEventListener('click', cerrar);
      tarjeta.querySelector('a')?.addEventListener('click', cerrar);
    })();
  </script>

  {conBarco && (
    <script>
      const barco = document.getElementById('barco');
      const actualizar = () => {
        const total = document.documentElement.scrollHeight - window.innerHeight;
        const p = total > 0 ? window.scrollY / total : 0;
        const x = p * (window.innerWidth - 34);
        if (barco) barco.style.transform = `translateX(${x}px)`;
      };
      addEventListener('scroll', actualizar, { passive: true });
      addEventListener('resize', actualizar);
      actualizar();
    </script>
  )}
</body>

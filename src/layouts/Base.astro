---
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource-variable/literata';
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
  conBarco?: boolean;
  claseBody?: string;
}

const {
  titulo = 'Memorias de Tomás Gómez Arroyo',
  descripcion = 'Las memorias de Tomás Gómez Arroyo, marino de la Armada Española, escritas por él mismo entre 1991 y 1995.',
  conBarco = false,
  claseBody = '',
} = Astro.props;

const tituloCompleto = titulo === 'Memorias de Tomás Gómez Arroyo'
  ? titulo
  : `${titulo} · Memorias de Tomás Gómez Arroyo`;
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://tomasgomezarroyo.github.io').replace(/\/+$/, '');
const apiOrigin = (import.meta.env.PUBLIC_API_ORIGIN || '').replace(/\/+$/, '');
const canonicalPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const canonical = new URL(canonicalPath, `${siteUrl}/`).toString();
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tituloCompleto}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={tituloCompleto} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:type" content="book" />
  <meta property="og:url" content={canonical} />
  <meta name="api-origin" content={apiOrigin} />
  <script is:inline>
    try {
      if (localStorage.getItem('memorias-tamano') === 'grande') {
        document.documentElement.dataset.lectura = 'grande';
      }
    } catch {}
  </script>
</head>
<body class={claseBody}>
  <a class="saltar" href="#contenido">Saltar al contenido</a>

  <header id="cabecera-sitio">
    <a class="marca-sitio" href="/" aria-label="Ir a la portada de las Memorias de Tomás Gómez Arroyo">
      <span aria-hidden="true">⚓</span>
      <span class="marca-larga">Memorias de Tomás Gómez Arroyo</span>
      <span class="marca-corta">Memorias</span>
    </a>
    <a class="libro-movil" href="/libro-de-visitas">Libro de visitas</a>
    <button type="button" id="abrir-menu-movil" aria-expanded="false" aria-controls="navegacion-principal">
      <span aria-hidden="true">☰</span>
      <span>Menú</span>
    </button>
    <nav id="navegacion-principal" aria-label="Navegación principal">
      <a href="/">Inicio</a>
      <a class="enlace-indice" href="/#titulo-indice">Memorias</a>
      <a href="/buques">Buques</a>
      <a href="/lugares">Lugares</a>
      <a href="/prensa">Prensa</a>
      <a href="/archivo">Archivo</a>
      <a href="/familia">Familia</a>
      <a href="/buscar" aria-label="Buscar una palabra o frase en las memorias">Buscar</a>
      <a href="/libro-de-visitas" aria-label="Libro de visitas y colaboraciones">Libro de visitas</a>
      <button type="button" data-tamano-global aria-pressed="false" aria-label="Activar letra grande">
        <span aria-hidden="true">A+</span>
        <span class="texto-boton">Letra</span>
      </button>
    </nav>
  </header>

  <script is:inline>
    (() => {
      const cabecera = document.getElementById('cabecera-sitio');
      const botonMenu = document.getElementById('abrir-menu-movil');
      const navegacion = document.getElementById('navegacion-principal');
      if (!cabecera || !botonMenu || !navegacion) return;
      const cerrar = () => {
        cabecera.removeAttribute('data-menu-abierto');
        botonMenu.setAttribute('aria-expanded', 'false');
      };
      botonMenu.addEventListener('click', () => {
        const abrir = !cabecera.hasAttribute('data-menu-abierto');
        cabecera.toggleAttribute('data-menu-abierto', abrir);
        botonMenu.setAttribute('aria-expanded', String(abrir));
      });
      navegacion.querySelectorAll('a').forEach((enlace) => enlace.addEventListener('click', cerrar));
      document.addEventListener('keydown', (evento) => {
        if (evento.key === 'Escape') {
          cerrar();
          botonMenu.focus();
        }
      });
      document.addEventListener('pointerdown', (evento) => {
        if (!cabecera.contains(evento.target)) cerrar();
      });
    })();
  </script>

  {conBarco && (
    <div id="horizonte" aria-hidden="true">
      <svg id="barco" viewBox="0 0 48 28" width="34" height="20">
        <g fill="currentColor">
          <path d="M2 20 L46 20 L42 26 L7 26 Z" />
          <rect x="17" y="14" width="14" height="6" rx="0.5" />
          <rect x="21" y="10" width="4" height="4" />
          <rect x="12" y="6" width="1.4" height="14" />
          <rect x="34" y="6" width="1.4" height="14" />
          <path d="M22 4 q3 -3 6 -1 q-2 2 -6 1 Z" opacity="0.5" />
        </g>
      </svg>
    </div>
  )}

  <script>
    const botonTamanoGlobal = document.querySelector('[data-tamano-global]') as HTMLButtonElement | null;
    const actualizarTamanoGlobal = () => {
      if (!botonTamanoGlobal) return;
      const grande = document.documentElement.dataset.lectura === 'grande';
      botonTamanoGlobal.setAttribute('aria-pressed', String(grande));
      botonTamanoGlobal.setAttribute('aria-label', grande ? 'Volver a la letra normal' : 'Activar letra grande');
      const texto = botonTamanoGlobal.querySelector('.texto-boton');
      if (texto) texto.textContent = grande ? 'Normal' : 'Letra';
    };
    botonTamanoGlobal?.addEventListener('click', () => {
      const grande = document.documentElement.dataset.lectura === 'grande';
      if (grande) delete document.documentElement.dataset.lectura;
      else document.documentElement.dataset.lectura = 'grande';
      try { localStorage.setItem('memorias-tamano', grande ? 'normal' : 'grande'); } catch {}
      actualizarTamanoGlobal();
      document.dispatchEvent(new CustomEvent('memorias:cambio-tamano'));
    });
    actualizarTamanoGlobal();
  </script>

  <audio id="narrador-global" preload="metadata"></audio>

  <aside id="barra-narracion" hidden aria-label="Reproductor de la narración">
    <div class="controles-capitulos" aria-label="Controles de capítulos">
      <button type="button" id="boton-capitulo-anterior" aria-label="Escuchar el capítulo anterior" title="Capítulo anterior">⏮</button>
      <button type="button" id="boton-narrador-flotante" aria-pressed="false" aria-label="Continuar la narración">▶</button>
      <button type="button" id="boton-capitulo-siguiente" aria-label="Escuchar el capítulo siguiente" title="Capítulo siguiente">⏭</button>
    </div>
    <div class="narrador-recorrido">
      <div class="narrador-datos">
        <span class="narrador-identidad">
          <span class="narrador-tipo">Narración</span>
          <span id="titulo-narracion">Capítulo en curso</span>
        </span>
        <span class="narrador-tiempos">
          <output id="tiempo-narracion-actual">0:00</output>
          <span aria-hidden="true"> / </span>
          <output id="tiempo-narracion-restante">−0:00</output>
        </span>
      </div>
      <input id="progreso-narracion" type="range" min="0" max="0" step="0.1" value="0" aria-label="Posición de la narración" />
    </div>
  </aside>

  <script>
    (() => {
      const audio = document.getElementById('narrador-global') as HTMLAudioElement | null;
      if (!audio) return;

      const CLAVE_SRC = 'memorias-narracion-src';
      const CLAVE_ESTADO = 'memorias-narracion-estado';
      const CLAVE_POSICION = 'memorias-narracion-posicion';
      const CLAVE_SIGUIENTE = 'memorias-narracion-siguiente';
      const CLAVE_TITULO = 'memorias-narracion-titulo';
      const CLAVE_VELOCIDAD = 'memorias-velocidad-narracion';
      const barra = document.getElementById('barra-narracion') as HTMLElement | null;
      const boton = document.getElementById('boton-narrador-flotante') as HTMLButtonElement | null;
      const botonAnterior = document.getElementById('boton-capitulo-anterior') as HTMLButtonElement | null;
      const botonSiguiente = document.getElementById('boton-capitulo-siguiente') as HTMLButtonElement | null;
      const tituloNarracion = document.getElementById('titulo-narracion');
      const progreso = document.getElementById('progreso-narracion') as HTMLInputElement | null;
      const tiempoActual = document.getElementById('tiempo-narracion-actual') as HTMLOutputElement | null;
      const tiempoRestante = document.getElementById('tiempo-narracion-restante') as HTMLOutputElement | null;

      const leer = (clave: string, alternativa = '') => {
        try { return sessionStorage.getItem(clave) || alternativa; } catch { return alternativa; }
      };
      const escribir = (clave: string, valor: string) => {
        try { sessionStorage.setItem(clave, valor); } catch {}
      };
      const formatoTiempo = (valor: number) => {
        if (!Number.isFinite(valor) || valor < 0) return '0:00';
        const total = Math.floor(valor);
        return String(Math.floor(total / 60)) + ':' + String(total % 60).padStart(2, '0');
      };
      const actualizarTiempo = () => {
        const duracion = Number.isFinite(audio.duration) ? audio.duration : 0;
        const actual = Number.isFinite(audio.currentTime) ? audio.currentTime : 0;
        if (progreso) {
          progreso.max = String(duracion);
          progreso.value = String(Math.min(actual, duracion || actual));
          progreso.setAttribute('aria-valuetext', formatoTiempo(actual) + ' de ' + formatoTiempo(duracion));
        }
        if (tiempoActual) tiempoActual.value = formatoTiempo(actual);
        if (tiempoRestante) tiempoRestante.value = '−' + formatoTiempo(Math.max(0, duracion - actual));
      };
      const actualizarControl = () => {
        const tieneNarracion = Boolean(leer(CLAVE_SRC));
        if (barra) barra.hidden = !tieneNarracion;
        if (tieneNarracion) document.documentElement.dataset.narracion = 'activa';
        else delete document.documentElement.dataset.narracion;
        const titulo = leer(CLAVE_TITULO, 'Capítulo en curso');
        if (tituloNarracion) tituloNarracion.textContent = titulo;
        if (boton) {
          const sonando = tieneNarracion && leer(CLAVE_ESTADO, 'pausada') === 'sonando';
          boton.setAttribute('aria-pressed', String(sonando));
          boton.setAttribute('aria-label', (sonando ? 'Pausar la narración: ' : 'Continuar la narración: ') + titulo);
          boton.title = titulo;
          boton.textContent = sonando ? '⏸' : '▶';
        }
        const indice = indiceCapituloActual();
        const anterior = indice > 0 ? capitulosNarrados[indice - 1] : undefined;
        const siguiente = indice >= 0 ? capitulosNarrados[indice + 1] : undefined;
        if (botonAnterior) {
          botonAnterior.disabled = !anterior;
          botonAnterior.setAttribute('aria-label', anterior ? `Escuchar ${anterior.titulo}` : 'No hay un capítulo anterior');
          botonAnterior.title = anterior ? `Anterior: ${anterior.titulo}` : 'No hay un capítulo anterior';
        }
        if (botonSiguiente) {
          botonSiguiente.disabled = !siguiente;
          botonSiguiente.setAttribute('aria-label', siguiente ? `Escuchar ${siguiente.titulo}` : 'No hay un capítulo siguiente');
          botonSiguiente.title = siguiente ? `Siguiente: ${siguiente.titulo}` : 'No hay un capítulo siguiente';
        }
        actualizarTiempo();
      };
      const notificar = () => {
        actualizarControl();
        document.dispatchEvent(new CustomEvent('memorias:narracion-estado', {
          detail: { src: audio.currentSrc || audio.src, estado: leer(CLAVE_ESTADO, 'pausada') },
        }));
      };
      const guardarPosicion = () => {
        if (Number.isFinite(audio.currentTime) && audio.currentTime >= 0) {
          escribir(CLAVE_POSICION, String(audio.currentTime));
        }
      };
      const restaurarPosicion = () => {
        const posicion = Number(leer(CLAVE_POSICION, '0'));
        if (Number.isFinite(posicion) && posicion > 0 && posicion < audio.duration) {
          audio.currentTime = posicion;
        }
        actualizarTiempo();
      };

      try {
        const velocidad = Number(localStorage.getItem(CLAVE_VELOCIDAD) || '1');
        if (Number.isFinite(velocidad) && velocidad > 0) audio.playbackRate = velocidad;
      } catch {}

      boton?.addEventListener('click', () => {
        if (leer(CLAVE_ESTADO, 'pausada') === 'sonando') {
          escribir(CLAVE_ESTADO, 'pausada');
          audio.pause();
        } else {
          escribir(CLAVE_ESTADO, 'sonando');
          audio.play().catch(() => {});
        }
        actualizarControl();
      });
      progreso?.addEventListener('input', () => {
        const destino = Number(progreso.value);
        if (!Number.isFinite(destino) || audio.readyState < 1) return;
        audio.currentTime = Math.max(0, Math.min(destino, audio.duration || destino));
        guardarPosicion();
        actualizarTiempo();
      });
      document.addEventListener('memorias:narracion-cambio', actualizarControl);
      audio.addEventListener('loadedmetadata', restaurarPosicion);
      audio.addEventListener('durationchange', actualizarTiempo);
      audio.addEventListener('timeupdate', () => {
        guardarPosicion();
        actualizarTiempo();
      });
      audio.addEventListener('play', notificar);
      audio.addEventListener('pause', notificar);
      const capitulosNarrados = [
        { slug: 'prologo', titulo: 'Prólogo' },
        { slug: 'capitulo-primero', titulo: 'Capítulo Primero' },
        { slug: 'capitulo-segundo', titulo: 'Capítulo Segundo' },
        { slug: 'capitulo-tercero', titulo: 'Capítulo Tercero' },
        { slug: 'capitulo-cuarto', titulo: 'Capítulo Cuarto' },
        { slug: 'capitulo-quinto', titulo: 'Capítulo Quinto' },
        { slug: 'capitulo-sexto', titulo: 'Capítulo Sexto' },
        { slug: 'capitulo-septimo', titulo: 'Capítulo Séptimo' },
        { slug: 'capitulo-octavo', titulo: 'Capítulo Octavo' },
        { slug: 'capitulo-noveno', titulo: 'Capítulo Noveno' },
        { slug: 'capitulo-decimo', titulo: 'Capítulo Décimo' },
      ];
      const indiceCapituloActual = () => {
        const ruta = new URL(leer(CLAVE_SRC) || audio.currentSrc || audio.src, location.href).pathname;
        const slug = ruta.split('/').pop()?.replace(/\.mp3$/, '') || '';
        return capitulosNarrados.findIndex((capitulo) => capitulo.slug === slug);
      };
      const cargarCapitulo = (indice: number, reproducir: boolean) => {
        const capitulo = capitulosNarrados[indice];
        if (!capitulo) return;
        const siguiente = capitulosNarrados[indice + 1];
        const versionAudio = capitulo.slug === 'capitulo-primero'
          ? '?v=20260824b'
          : capitulo.slug === 'capitulo-octavo' ? '?v=20260824'
          : capitulo.slug === 'capitulo-quinto'
          ? '?v=20260825b'
          : ['capitulo-segundo', 'capitulo-tercero', 'capitulo-cuarto', 'capitulo-sexto'].includes(capitulo.slug)
            ? '?v=20260825'
            : '';
        const nuevoSrc = `/media/narracion/${capitulo.slug}.mp3${versionAudio}`;
        escribir(CLAVE_SRC, nuevoSrc);
        escribir(CLAVE_TITULO, capitulo.titulo);
        escribir(CLAVE_SIGUIENTE, siguiente ? `/capitulo/${siguiente.slug}` : '');
        escribir(CLAVE_POSICION, '0');
        escribir(CLAVE_ESTADO, reproducir ? 'sonando' : 'pausada');
        audio.src = nuevoSrc;
        audio.load();
        notificar();
        if (reproducir) {
          audio.play().catch(() => {
            const reanudar = () => audio.play().catch(() => {});
            addEventListener('pointerdown', reanudar, { once: true, capture: true });
          });
        }
      };
      const cambiarCapitulo = (desplazamiento: number) => {
        const indice = indiceCapituloActual();
        const destino = indice + desplazamiento;
        if (indice < 0 || !capitulosNarrados[destino]) return;
        cargarCapitulo(destino, leer(CLAVE_ESTADO, 'pausada') === 'sonando');
      };
      botonAnterior?.addEventListener('click', () => cambiarCapitulo(-1));
      botonSiguiente?.addEventListener('click', () => cambiarCapitulo(1));
      audio.addEventListener('ended', () => {
        const indice = indiceCapituloActual();
        if (indice < 0 || !capitulosNarrados[indice + 1]) {
          escribir(CLAVE_ESTADO, 'pausada');
          escribir(CLAVE_POSICION, '0');
          notificar();
          return;
        }
        cargarCapitulo(indice + 1, true);
      });
      addEventListener('pagehide', guardarPosicion);

      let src = leer(CLAVE_SRC);
      if (src) {
        const urlGuardada = new URL(src, location.href);
        const versionesAudio: Record<string, string> = {
          'capitulo-primero': '20260824b',
          'capitulo-segundo': '20260825',
          'capitulo-tercero': '20260825',
          'capitulo-cuarto': '20260825',
          'capitulo-quinto': '20260825b',
          'capitulo-sexto': '20260825',
          'capitulo-octavo': '20260824',
        };
        const slugGuardado = urlGuardada.pathname.split('/').pop()?.replace(/\.mp3$/, '') || '';
        const versionEsperada = versionesAudio[slugGuardado];
        if (versionEsperada && urlGuardada.searchParams.get('v') !== versionEsperada) {
          src = `/media/narracion/${slugGuardado}.mp3?v=${versionEsperada}`;
          escribir(CLAVE_SRC, src);
          escribir(CLAVE_POSICION, '0');
        }
      }
      actualizarControl();
      if (!src) return;
      audio.src = src;

      if (leer(CLAVE_ESTADO) === 'sonando') {
        const reanudar = () => {
          if (leer(CLAVE_ESTADO) !== 'sonando') return;
          audio.play().catch(() => {});
        };
        audio.play().catch(() => {
          addEventListener('pointerdown', reanudar, { once: true, capture: true });
        });
      }
    })();
  </script>
  <aside id="control-audio" aria-label="Controles de audio">
    <div class="canal-audio" id="canal-musica">
      <span class="audio-etiqueta">Música</span>
      <div class="audio-acciones">
        <audio id="audio-fondo" src="/audio/leyenda-del-beso-intermedio-1930.mp3" preload="auto"></audio>
        <button type="button" id="boton-play" aria-pressed="false" aria-label="Reproducir música de fondo: La leyenda del beso" title="Reproducir música de fondo">▶</button>
        <button type="button" id="boton-mute" aria-pressed="false" aria-label="Silenciar la música de fondo" title="Silenciar">🔊</button>
        <input type="range" id="volumen-musica" min="0" max="100" step="5" value="60" aria-label="Volumen de la música de fondo" title="Volumen" />
      </div>
    </div>

  </aside>

  <script>
    (() => {
      const audio = document.getElementById('audio-fondo') as HTMLAudioElement | null;
      const botonPlay = document.getElementById('boton-play') as HTMLButtonElement | null;
      const botonMute = document.getElementById('boton-mute') as HTMLButtonElement | null;
      const deslizador = document.getElementById('volumen-musica') as HTMLInputElement | null;
      if (!audio || !botonPlay || !botonMute) return;

      // Volumen: se guarda y se restaura entre páginas.
      let volumenGuardado = 60;
      try {
        const guardado = localStorage.getItem('memorias-volumen');
        if (guardado !== null) volumenGuardado = Number(guardado);
      } catch {}
      audio.volume = volumenGuardado / 100;
      if (deslizador) {
        deslizador.value = String(volumenGuardado);
        deslizador.addEventListener('input', () => {
          const valor = Number(deslizador.value);
          audio.volume = valor / 100;
          try { localStorage.setItem('memorias-volumen', String(valor)); } catch {}
          if (audio.muted && valor > 0) audio.muted = false; // mover el volumen desmutea
        });
      }

      // Silenciar (el "parlantito"): apaga el sonido sin pausar la reproducción,
      // independiente del botón de reproducir/pausar.
      let mutedGuardado = false;
      try { mutedGuardado = localStorage.getItem('memorias-silenciada') === 'si'; } catch {}
      audio.muted = mutedGuardado;
      const actualizarMute = () => {
        botonMute.setAttribute('aria-pressed', String(audio.muted));
        botonMute.setAttribute('aria-label', audio.muted ? 'Activar el sonido' : 'Silenciar la música de fondo');
        botonMute.title = audio.muted ? 'Activar el sonido' : 'Silenciar';
        botonMute.textContent = audio.muted ? '🔇' : '🔊';
      };
      actualizarMute();
      botonMute.addEventListener('click', () => {
        audio.muted = !audio.muted;
        try { localStorage.setItem('memorias-silenciada', audio.muted ? 'si' : 'no'); } catch {}
        actualizarMute();
      });

      // Reproducir / pausar.
      const marcarSonando = () => {
        botonPlay.setAttribute('aria-pressed', 'true');
        botonPlay.setAttribute('aria-label', 'Pausar la música de fondo: La leyenda del beso');
        botonPlay.title = 'Pausar';
        botonPlay.textContent = '⏸';
      };
      const marcarPausada = () => {
        botonPlay.setAttribute('aria-pressed', 'false');
        botonPlay.setAttribute('aria-label', 'Reproducir música de fondo: La leyenda del beso');
        botonPlay.title = 'Reproducir música de fondo';
        botonPlay.textContent = '▶';
      };

      const detenidaPorElVisitante = () => {
        try { return localStorage.getItem('memorias-musica') === 'apagada'; } catch { return false; }
      };

      // El sitio es multipágina (cada clic recarga la página, no es una app de
      // una sola página): el <audio> se destruye y se vuelve a crear en cada
      // navegación. Para que no vuelva a sonar desde 0:00, se guarda el punto
      // exacto donde iba y se retoma ahí al cargar la página siguiente.
      const guardarPosicion = () => {
        if (audio.currentTime > 0) {
          try { localStorage.setItem('memorias-posicion', String(audio.currentTime)); } catch {}
        }
      };
      const posicionGuardada = (() => {
        try { return Number(localStorage.getItem('memorias-posicion') || '0'); } catch { return 0; }
      })();
      if (posicionGuardada > 0 && posicionGuardada < audio.duration) {
        audio.currentTime = posicionGuardada;
      } else if (posicionGuardada > 0) {
        // La duración aún no está disponible al primer intento; se aplica en cuanto se conozca.
        audio.addEventListener('loadedmetadata', () => {
          if (posicionGuardada < audio.duration) audio.currentTime = posicionGuardada;
        }, { once: true });
      }
      audio.addEventListener('timeupdate', guardarPosicion);
      addEventListener('pagehide', guardarPosicion);

      audio.addEventListener('play', marcarSonando);
      audio.addEventListener('pause', marcarPausada);

      // Sin loop: suena una vez y se detiene. Si terminó, no hay que retomarla
      // al entrar a otra página; y si el visitante vuelve a pulsar «Reproducir»,
      // empieza de nuevo desde el principio, no se queda congelada al final.
      audio.addEventListener('ended', () => {
        try {
          localStorage.setItem('memorias-musica', 'apagada');
          localStorage.setItem('memorias-posicion', '0');
        } catch {}
      });

      botonPlay.addEventListener('click', () => {
        if (audio.paused) {
          if (audio.ended || audio.currentTime >= audio.duration - 0.25) audio.currentTime = 0;
          audio.play().catch(() => {});
          try { localStorage.setItem('memorias-musica', 'sonando'); } catch {}
        } else {
          audio.pause();
          try { localStorage.setItem('memorias-musica', 'apagada'); } catch {}
        }
      });

      if (!detenidaPorElVisitante()) {
        audio.play().catch(() => {
          // El navegador bloqueó el autoplay con sonido (política estándar hasta que
          // haya una interacción del visitante en este sitio). Queda el botón visible.
          marcarPausada();
        });
      }
    })();
  </script>


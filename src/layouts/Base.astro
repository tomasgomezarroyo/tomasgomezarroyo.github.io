---
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource-variable/literata';
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
  conBarco?: boolean;
  claseBody?: string;
}

const {
  titulo = 'Memorias de Tomás Gómez Arroyo',
  descripcion = 'Las memorias de Tomás Gómez Arroyo, marino de la Armada Española, escritas por él mismo entre 1991 y 1995.',
  conBarco = false,
  claseBody = '',
} = Astro.props;

const tituloCompleto = titulo === 'Memorias de Tomás Gómez Arroyo'
  ? titulo
  : `${titulo} · Memorias de Tomás Gómez Arroyo`;
const canonical = new URL(Astro.url.pathname, 'https://tomasgomezarroyo.pages.dev').toString();
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tituloCompleto}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={tituloCompleto} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:type" content="book" />
  <meta property="og:url" content={canonical} />
  <script is:inline>
    try {
      if (localStorage.getItem('memorias-tamano') === 'grande') {
        document.documentElement.dataset.lectura = 'grande';
      }
    } catch {}
  </script>
</head>
<body class={claseBody}>
  <a class="saltar" href="#contenido">Saltar al contenido</a>

  <header id="cabecera-sitio">
    <a class="marca-sitio" href="/" aria-label="Ir a la portada de las Memorias de Tomás Gómez Arroyo">
      <span aria-hidden="true">⚓</span>
      <span>Memorias de Tomás Gómez Arroyo</span>
    </a>
    <nav aria-label="Navegación principal">
      <a href="/">Inicio</a>
      <a href="/#titulo-indice">Índice</a>
      <a href="/buques">Buques</a>
      <a href="/lugares">Lugares</a>
      <a href="/prensa">Prensa</a>
      <button type="button" data-tamano-global aria-pressed="false" aria-label="Activar letra grande">
        <span aria-hidden="true">A+</span>
        <span class="texto-boton">Letra</span>
      </button>
    </nav>
  </header>

  {conBarco && (
    <div id="horizonte" aria-hidden="true">
      <svg id="barco" viewBox="0 0 48 28" width="34" height="20">
        <g fill="currentColor">
          <path d="M2 20 L46 20 L42 26 L7 26 Z" />
          <rect x="17" y="14" width="14" height="6" rx="0.5" />
          <rect x="21" y="10" width="4" height="4" />
          <rect x="12" y="6" width="1.4" height="14" />
          <rect x="34" y="6" width="1.4" height="14" />
          <path d="M22 4 q3 -3 6 -1 q-2 2 -6 1 Z" opacity="0.5" />
        </g>
      </svg>
    </div>
  )}

  <script>
    const botonTamanoGlobal = document.querySelector('[data-tamano-global]') as HTMLButtonElement | null;
    const actualizarTamanoGlobal = () => {
      if (!botonTamanoGlobal) return;
      const grande = document.documentElement.dataset.lectura === 'grande';
      botonTamanoGlobal.setAttribute('aria-pressed', String(grande));
      botonTamanoGlobal.setAttribute('aria-label', grande ? 'Volver a la letra normal' : 'Activar letra grande');
      const texto = botonTamanoGlobal.querySelector('.texto-boton');
      if (texto) texto.textContent = grande ? 'Normal' : 'Letra';
    };
    botonTamanoGlobal?.addEventListener('click', () => {
      const grande = document.documentElement.dataset.lectura === 'grande';
      if (grande) delete document.documentElement.dataset.lectura;
      else document.documentElement.dataset.lectura = 'grande';
      try { localStorage.setItem('memorias-tamano', grande ? 'normal' : 'grande'); } catch {}
      actualizarTamanoGlobal();
      document.dispatchEvent(new CustomEvent('memorias:cambio-tamano'));
    });
    actualizarTamanoGlobal();
  </script>

  <div id="musica-fondo">
    <audio id="audio-fondo" src="/audio/leyenda-del-beso-intermedio-1930.mp3" preload="auto"></audio>
    <button type="button" id="boton-play" aria-pressed="false" aria-label="Reproducir música de fondo: La leyenda del beso" title="Reproducir música de fondo">▶</button>
    <button type="button" id="boton-mute" aria-pressed="false" aria-label="Silenciar la música de fondo" title="Silenciar">🔊</button>
    <input type="range" id="volumen-musica" min="0" max="100" step="5" value="60" aria-label="Volumen de la música de fondo" title="Volumen" />
  </div>

  <script>
    (() => {
      const audio = document.getElementById('audio-fondo') as HTMLAudioElement | null;
      const botonPlay = document.getElementById('boton-play') as HTMLButtonElement | null;
      const botonMute = document.getElementById('boton-mute') as HTMLButtonElement | null;
      const deslizador = document.getElementById('volumen-musica') as HTMLInputElement | null;
      if (!audio || !botonPlay || !botonMute) return;

      // Volumen: se guarda y se restaura entre páginas.
      let volumenGuardado = 60;
      try {
        const guardado = localStorage.getItem('memorias-volumen');
        if (guardado !== null) volumenGuardado = Number(guardado);
      } catch {}
      audio.volume = volumenGuardado / 100;
      if (deslizador) {
        deslizador.value = String(volumenGuardado);
        deslizador.addEventListener('input', () => {
          const valor = Number(deslizador.value);
          audio.volume = valor / 100;
          try { localStorage.setItem('memorias-volumen', String(valor)); } catch {}
          if (audio.muted && valor > 0) audio.muted = false; // mover el volumen desmutea
        });
      }

      // Silenciar (el "parlantito"): apaga el sonido sin pausar la reproducción,
      // independiente del botón de reproducir/pausar.
      let mutedGuardado = false;
      try { mutedGuardado = localStorage.getItem('memorias-silenciada') === 'si'; } catch {}
      audio.muted = mutedGuardado;
      const actualizarMute = () => {
        botonMute.setAttribute('aria-pressed', String(audio.muted));
        botonMute.setAttribute('aria-label', audio.muted ? 'Activar el sonido' : 'Silenciar la música de fondo');
        botonMute.title = audio.muted ? 'Activar el sonido' : 'Silenciar';
        botonMute.textContent = audio.muted ? '🔇' : '🔊';
      };
      actualizarMute();
      botonMute.addEventListener('click', () => {
        audio.muted = !audio.muted;
        try { localStorage.setItem('memorias-silenciada', audio.muted ? 'si' : 'no'); } catch {}
        actualizarMute();
      });

      // Reproducir / pausar.
      const marcarSonando = () => {
        botonPlay.setAttribute('aria-pressed', 'true');
        botonPlay.setAttribute('aria-label', 'Pausar la música de fondo: La leyenda del beso');
        botonPlay.title = 'Pausar';
        botonPlay.textContent = '⏸';
      };
      const marcarPausada = () => {
        botonPlay.setAttribute('aria-pressed', 'false');
        botonPlay.setAttribute('aria-label', 'Reproducir música de fondo: La leyenda del beso');
        botonPlay.title = 'Reproducir música de fondo';
        botonPlay.textContent = '▶';
      };

      const detenidaPorElVisitante = () => {
        try { return localStorage.getItem('memorias-musica') === 'apagada'; } catch { return false; }
      };

      // El sitio es multipágina (cada clic recarga la página, no es una app de
      // una sola página): el <audio> se destruye y se vuelve a crear en cada
      // navegación. Para que no vuelva a sonar desde 0:00, se guarda el punto
      // exacto donde iba y se retoma ahí al cargar la página siguiente.
      const guardarPosicion = () => {
        if (audio.currentTime > 0) {
          try { localStorage.setItem('memorias-posicion', String(audio.currentTime)); } catch {}
        }
      };
      const posicionGuardada = (() => {
        try { return Number(localStorage.getItem('memorias-posicion') || '0'); } catch { return 0; }
      })();
      if (posicionGuardada > 0 && posicionGuardada < audio.duration) {
        audio.currentTime = posicionGuardada;
      } else if (posicionGuardada > 0) {
        // La duración aún no está disponible al primer intento; se aplica en cuanto se conozca.
        audio.addEventListener('loadedmetadata', () => {
          if (posicionGuardada < audio.duration) audio.currentTime = posicionGuardada;
        }, { once: true });
      }
      audio.addEventListener('timeupdate', guardarPosicion);
      addEventListener('pagehide', guardarPosicion);

      audio.addEventListener('play', marcarSonando);
      audio.addEventListener('pause', marcarPausada);

      // Sin loop: suena una vez y se detiene. Si terminó, no hay que retomarla
      // al entrar a otra página; y si el visitante vuelve a pulsar «Reproducir»,
      // empieza de nuevo desde el principio, no se queda congelada al final.
      audio.addEventListener('ended', () => {
        try {
          localStorage.setItem('memorias-musica', 'apagada');
          localStorage.setItem('memorias-posicion', '0');
        } catch {}
      });

      botonPlay.addEventListener('click', () => {
        if (audio.paused) {
          if (audio.ended || audio.currentTime >= audio.duration - 0.25) audio.currentTime = 0;
          audio.play().catch(() => {});
          try { localStorage.setItem('memorias-musica', 'sonando'); } catch {}
        } else {
          audio.pause();
          try { localStorage.setItem('memorias-musica', 'apagada'); } catch {}
        }
      });

      if (!detenidaPorElVisitante()) {
        audio.play().catch(() => {
          // El navegador bloqueó el autoplay con sonido (política estándar hasta que
          // haya una interacción del visitante en este sitio). Queda el botón visible.
          marcarPausada();
        });
      }
    })();
  </script>

  <div id="contenido" tabindex="-1"><slot /></div>

  <footer id="pie-sitio">
    <hr class="filete" />
    <nav aria-label="Secciones">
      <a href="/">Portada</a>
      <a href="/travesia">La travesía</a>
      <a href="/buques">Los buques</a>
      <a href="/lugares">Los lugares</a>
      <a href="/prensa">Prensa</a>
      <a href="/epilogo">Epílogo</a>
      <a href="/sobre-esta-edicion">Sobre esta edición</a>
    </nav>
    <p class="etiqueta">Memorias de Tomás Gómez Arroyo</p>
  </footer>

  {conBarco && (
    <script>
      const barco = document.getElementById('barco');
      const actualizar = () => {
        const total = document.documentElement.scrollHeight - window.innerHeight;
        const p = total > 0 ? window.scrollY / total : 0;
        const x = p * (window.innerWidth - 34);
        if (barco) barco.style.transform = `translateX(${x}px)`;
      };
      addEventListener('scroll', actualizar, { passive: true });
      addEventListener('resize', actualizar);
      actualizar();
    </script>
  )}
</body>
</html>

<style>
  .saltar {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 1000;
    padding: 0.65rem 1rem;
    background: var(--papel);
    color: var(--marino);
    border: 2px solid var(--oro);
    transform: translateY(-150%);
  }
  .saltar:focus { transform: translateY(0); }

  #musica-fondo {
    position: fixed;
    right: 0.9rem;
    bottom: 0.9rem;
    z-index: 200;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--oro-claro);
    border-radius: 2.5rem;
    background: color-mix(in srgb, var(--papel) 94%, transparent);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.18);
    backdrop-filter: blur(6px);
  }
  #boton-play,
  #boton-mute {
    min-height: 2.9rem;
    min-width: 2.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 50%;
    background: transparent;
    color: var(--marino);
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
  }
  #boton-play:hover, #boton-play:focus-visible,
  #boton-mute:hover, #boton-mute:focus-visible {
    background: color-mix(in srgb, var(--oro-claro) 35%, transparent);
  }
  #boton-play[aria-pressed='true'] { background: var(--marino); color: var(--papel); }
  #boton-mute[aria-pressed='true'] { color: var(--bruma); }
  #volumen-musica {
    width: 5.5rem;
    height: 2.9rem;
    accent-color: var(--marino);
    cursor: pointer;
  }
  @media (max-width: 480px) {
    #musica-fondo { right: 0.6rem; bottom: 0.6rem; padding: 0.3rem 0.5rem; gap: 0.15rem; }
    #boton-play, #boton-mute { min-height: 2.6rem; min-width: 2.6rem; font-size: 1.05rem; }
    #volumen-musica { width: 4.2rem; }
  }

  #cabecera-sitio {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    min-height: 3.35rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.25rem max(0.65rem, calc((100vw - 72rem) / 2));
    border-bottom: 1px solid color-mix(in srgb, var(--oro) 52%, transparent);
    background: color-mix(in srgb, var(--papel) 96%, transparent);
    box-shadow: 0 2px 12px rgb(0 0 0 / 0.08);
    backdrop-filter: blur(10px);
  }
  .marca-sitio {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0 0.35rem;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
    white-space: nowrap;
  }
  #cabecera-sitio nav { display: flex; align-items: center; gap: 0.2rem; }
  #cabecera-sitio nav a,
  #cabecera-sitio nav button {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.3rem 0.62rem;
    border: 1px solid transparent;
    border-radius: 0.2rem;
    background: transparent;
    color: var(--marino);
    font: 600 0.88rem/1.1 var(--f-cuerpo);
    text-decoration: none;
    cursor: pointer;
  }
  #cabecera-sitio nav button {
    gap: 0.28rem;
    border-color: color-mix(in srgb, var(--oro) 58%, transparent);
    background: var(--papel-2);
  }
  #cabecera-sitio nav button[aria-pressed='true'] {
    background: var(--marino);
    color: var(--papel);
    border-color: var(--marino);
  }
  #cabecera-sitio nav a:hover,
  #cabecera-sitio nav button:hover { background: color-mix(in srgb, var(--oro-claro) 25%, transparent); }

  #horizonte {
    position: fixed;
    top: 3.35rem; left: 0; right: 0;
    height: 34px;
    z-index: 50;
    color: var(--marino);
    pointer-events: none;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--papel) 88%, transparent) 0 26px, transparent 26px);
  }
  #horizonte::after {
    content: '';
    position: absolute;
    top: 26px; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, color-mix(in srgb, var(--marino) 45%, transparent) 12%, color-mix(in srgb, var(--marino) 45%, transparent) 88%, transparent);
  }
  #barco {
    position: absolute;
    top: 7px;
    left: 0;
    transition: transform 120ms linear;
    will-change: transform;
  }

  #pie-sitio { padding: 3.5rem 1.5rem 3rem; text-align: center; }
  #pie-sitio nav {
    margin: 1.8rem 0 1rem;
    display: flex;
    gap: 0.65rem 1.4rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  #pie-sitio nav a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    padding: 0 0.25rem;
    font-family: var(--f-cuerpo);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 0.95rem;
    text-decoration: none;
  }

  @media (max-width: 720px) {
    #cabecera-sitio { justify-content: center; }
    .marca-sitio { display: none; }
    #cabecera-sitio nav { width: 100%; justify-content: space-between; }
    #cabecera-sitio nav a,
    #cabecera-sitio nav button { flex: 1 1 auto; padding-inline: 0.35rem; }
  }

  @media (max-width: 390px) {
    #cabecera-sitio nav a,
    #cabecera-sitio nav button { font-size: 0.78rem; }
    #cabecera-sitio nav button .texto-boton { display: none; }
  }
</style>

---
import Base from '../../layouts/Base.astro';
import { documentos } from '../../data/archivo';

export function getStaticPaths() {
  return documentos.map((d) => ({ params: { slug: d.slug }, props: { documento: d } }));
}
const { documento } = Astro.props;
---
<Base titulo={documento.titulo} descripcion={`${documento.titulo}, ${documento.fecha}: documento original y traducción del archivo de Tomás Gómez Arroyo.`} conBarco={true}>
  <main class="detalle-buque">
    <nav class="migas" aria-label="Ruta">
      <a href="/archivo">Todo el archivo</a>
    </nav>
    <header>
      <h1 class="display">{documento.titulo}</h1>
      <p class="fecha-cabecera">{documento.fecha}</p>
      <p>{documento.resumen}</p>
    </header>

    <section class="galeria" aria-label={`Páginas de ${documento.titulo}`} data-galeria>
      <div class="marco-imagen">
        <button class="imagen-principal" type="button" aria-label={`Ampliar la página de ${documento.titulo}`} data-ampliar>
          <img src={documento.paginas[0].src} alt={documento.paginas[0].alt} data-principal />
          <span class="abrir-lupa">Ampliar página</span>
        </button>
        {documento.paginas.length > 1 && (
          <>
            <button type="button" class="flecha flecha-izq" data-anterior aria-label="Página anterior">‹</button>
            <button type="button" class="flecha flecha-der" data-siguiente aria-label="Página siguiente">›</button>
          </>
        )}
      </div>
      <div class="pie-activo" aria-live="polite">
        <p class="contador" data-contador>Página 1 de {documento.paginas.length}</p>
        <p data-pie>{documento.paginas[0].pie}</p>
      </div>
      {documento.paginas.length > 1 && (
        <div class="miniaturas" role="list" aria-label="Seleccionar página">
          {documento.paginas.map((pag, i) => (
            <button
              type="button"
              role="listitem"
              class={i === 0 ? 'activa' : ''}
              aria-label={`Mostrar página ${i + 1} de ${documento.paginas.length}: ${pag.alt}`}
              data-miniatura
              data-src={pag.src}
              data-alt={pag.alt}
              data-pie={pag.pie}
            ><img src={pag.src} alt="" loading="lazy" /><span>Pág. {i + 1}</span></button>
          ))}
        </div>
      )}
      <p class="ayuda">Pulse «Ampliar página» para leer el original de cerca. Dentro de la lupa puede acercarse hasta cinco veces y arrastrar la imagen para recorrer sus detalles.</p>

      <dialog data-visor aria-label={`Página ampliada de ${documento.titulo}`}>
        <button class="cerrar" type="button" aria-label="Cerrar la página ampliada" data-cerrar>Cerrar ✕</button>
        {documento.paginas.length > 1 && (
          <>
            <button type="button" class="flecha flecha-visor flecha-izq" data-visor-anterior aria-label="Página anterior">‹</button>
            <button type="button" class="flecha flecha-visor flecha-der" data-visor-siguiente aria-label="Página siguiente">›</button>
          </>
        )}
        <div class="lienzo" data-lienzo><img src="" alt="" data-visor-img draggable="false" /></div>
        <div class="controles" role="group" aria-label="Controles de ampliación">
          <button type="button" data-menos aria-label="Alejar">− Alejar</button>
          <button type="button" data-restablecer aria-label="Ajustar el zoom al tamaño de pantalla">Ajustar</button>
          <output data-zoom aria-live="polite">100 %</output>
          <button type="button" data-mas aria-label="Acercar">+ Acercar</button>
          <a data-original href={documento.paginas[0].src} target="_blank" rel="noopener" aria-label="Ver la página a tamaño original en una pestaña nueva">↗ Tamaño original</a>
        </div>
      </dialog>
    </section>

    <section class="documentacion" aria-labelledby="titulo-documentacion">
      <h2 id="titulo-documentacion">Ficha documental</h2>
      <dl>
        <div><dt>Pieza</dt><dd>{documento.pieza}</dd></div>
        <div><dt>Tipo de documento</dt><dd>{documento.tipoDocumento}</dd></div>
        <div><dt>Contexto</dt><dd>{documento.contexto}</dd></div>
        <div><dt>Personas mencionadas</dt><dd><ul>{documento.personas.map((persona) => <li>{persona}</li>)}</ul></dd></div>
        <div><dt>Crédito</dt><dd>{documento.credito}</dd></div>
        <div><dt>Derechos y uso</dt><dd>{documento.derechos}</dd></div>
        <div><dt>Fecha de consulta</dt><dd>{documento.fechaConsulta}</dd></div>
      </dl>
    </section>

    <section class="texto-paralelo" aria-labelledby="titulo-texto">
      <h2 id="titulo-texto">Original y traducción</h2>
      <p class="criterio">La transcripción conserva ortografía, puntuación y cortes del original en inglés. La traducción busca fidelidad de sentido en español correcto; las decisiones de traducción se anotan cuando aportan algo relevante.</p>
      {documento.secciones.map((s) => (
        <article class="seccion-texto">
          <h3>{s.titulo} <span class="ref-pagina">— página {s.paginaRef} de {documento.paginas.length}</span></h3>
          <div class="parallel">
            <div class="panel">
              <p class="etiqueta-panel">Original (inglés)</p>
              <div class="cuerpo-texto">{s.original}</div>
            </div>
            <div class="panel">
              <p class="etiqueta-panel">Traducción (español)</p>
              <div class="cuerpo-texto">{s.traduccion}</div>
            </div>
          </div>
          {s.notas.length > 0 && (
            <ul class="notas">
              {s.notas.map((n) => (
                <li>
                  {n.texto}
                  {n.fuenteUrl && n.fuenteTexto && (
                    <> <a href={n.fuenteUrl} target="_blank" rel="noopener">[Fuente: {n.fuenteTexto} ↗]</a></>
                  )}
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </section>

    <section class="fuente" aria-labelledby="titulo-fuente">
      <h2 id="titulo-fuente">Documento completo</h2>
      <p>Cedido por {documento.fuenteTexto}. Condiciones de uso detalladas en «Derechos y uso», arriba.</p>
      <p class="botones-fuente">
        <a class="boton-descarga" href={documento.documentoUrl} download>⬇ Descargar el expediente completo ({documento.documentoTamano})</a>
      </p>
      <p class="nota-enlace">Esta sección es una excepción deliberada, igual que Prensa: los enlaces a fuentes externas dentro de las notas de lectura (BOE, historiales oficiales, etc.) prueban la procedencia de cada dato y son parte del contenido mismo. El resto del sitio no lleva enlaces externos.</p>
    </section>

    <nav class="acciones" aria-label="Continuar">
      <a href="/archivo">Volver a todo el archivo</a>
    </nav>
  </main>
</Base>

<style>
  .detalle-buque { max-width: 54rem; margin: 0 auto; padding: 5.8rem 1.4rem 3rem; }
  .migas { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.5rem 1rem; }
  .migas a, .acciones a { min-height: 2.75rem; display: inline-flex; align-items: center; }
  header { text-align: center; max-width: 40rem; margin: 1.2rem auto 2.2rem; }
  h1 { font-size: clamp(1.9rem, 6vw, 2.9rem); margin: 0.3rem 0 0.4rem; }
  .fecha-cabecera { font-weight: 700; color: var(--marino); margin-bottom: 0.6rem; }
  .galeria { max-width: 48rem; margin: 0 auto; }
  .marco-imagen { position: relative; }
  .imagen-principal { position: relative; width: 100%; padding: 7px; border: 1px solid var(--oro); background: var(--papel-2); cursor: zoom-in; }
  .imagen-principal img { display: block; width: 100%; max-height: 68vh; object-fit: contain; background: #101820; }
  .abrir-lupa {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border: 1px solid var(--oro-claro);
    background: rgb(14 26 40 / 0.92);
    color: var(--papel);
    font: 600 13px/1.2 var(--f-cuerpo);
  }
  .flecha {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 44px;
    height: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--oro-claro);
    border-radius: 50%;
    background: rgb(14 26 40 / 0.85);
    color: var(--papel);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }
  .flecha:hover, .flecha:focus-visible { background: rgb(14 26 40 / 0.98); }
  .flecha-izq { left: 0.5rem; }
  .flecha-der { right: 0.5rem; }
  .pie-activo { margin: 0.8rem auto 1rem; text-align: center; max-width: 42rem; }
  .contador { margin-bottom: 0.25rem; font-weight: 700; color: var(--marino); }
  .miniaturas { display: flex; gap: 0.65rem; overflow-x: auto; padding: 0.4rem 0.2rem 0.8rem; }
  .miniaturas button { flex: 0 0 104px; min-height: 92px; padding: 4px; border: 2px solid transparent; background: var(--papel-2); color: var(--marino); cursor: pointer; }
  .miniaturas button.activa { border-color: var(--oro); }
  .miniaturas img { display: block; width: 100%; height: 68px; object-fit: cover; object-position: top; }
  .miniaturas span { display: block; padding-top: 0.15rem; font-size: 12px; font-weight: 700; }
  .ayuda { font-size: 0.92rem; color: var(--bruma); text-align: center; }

  .documentacion { margin: 3rem auto 0; max-width: 46rem; }
  .documentacion h2 { font-family: var(--f-display); color: var(--marino); text-align: center; font-size: 1.55rem; margin-bottom: 1rem; }
  .documentacion dl { border-top: 1px solid var(--oro); }
  .documentacion dl > div { display: grid; grid-template-columns: minmax(10rem, 0.8fr) minmax(0, 2fr); gap: 1rem 1.4rem; padding: 0.9rem 0; border-bottom: 1px solid color-mix(in srgb, var(--oro) 45%, transparent); }
  .documentacion dt { font-weight: 700; color: var(--marino); }
  .documentacion dd { margin: 0; }
  .documentacion ul { margin: 0; padding-left: 1.2rem; }

  .texto-paralelo { margin: 3.2rem auto 0; max-width: 54rem; }
  .texto-paralelo > h2 { font-family: var(--f-display); color: var(--marino); text-align: center; font-size: 1.55rem; margin-bottom: 0.5rem; }
  .criterio { text-align: center; max-width: 42rem; margin: 0 auto 2rem; font-size: 0.92rem; color: var(--bruma); }
  .seccion-texto { margin-bottom: 2.6rem; padding-bottom: 2.2rem; border-bottom: 1px solid color-mix(in srgb, var(--oro) 40%, transparent); }
  .seccion-texto:last-child { border-bottom: none; }
  .seccion-texto h3 { font-family: var(--f-display); font-size: 1.25rem; color: var(--marino); margin-bottom: 1rem; }
  .ref-pagina { font-family: var(--f-cuerpo); font-size: 0.82rem; font-weight: 400; color: var(--bruma); }
  .parallel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.4rem; }
  .panel { min-width: 0; background: var(--papel-2); border: 1px solid color-mix(in srgb, var(--oro) 45%, transparent); padding: 1rem 1.1rem; }
  .etiqueta-panel { margin: 0 0 0.6rem; font-size: 0.76rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--oro); }
  /* El original conserva su sangría mecanografiada: si una línea no cabe, se
     desplaza dentro de su propia caja en vez de ensanchar la página. */
  .cuerpo-texto { white-space: pre-wrap; overflow-x: auto; overflow-wrap: break-word; font-size: 0.96rem; line-height: 1.55; }
  .notas { margin: 1rem 0 0; padding-left: 1.2rem; font-size: 0.88rem; color: var(--bruma); }
  .notas li { margin-bottom: 0.4rem; }
  .notas a { color: var(--marino); }

  .fuente { margin: 3rem auto 0; max-width: 42rem; padding: 1.6rem; border: 1px solid var(--oro); background: var(--papel-2); text-align: center; }
  .fuente h2 { font-family: var(--f-display); color: var(--marino); margin-bottom: 0.5rem; font-size: 1.3rem; }
  .botones-fuente { margin-top: 1rem; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem; }
  .botones-fuente a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    border: 1px solid var(--marino);
    background: var(--marino);
    color: var(--papel);
    text-decoration: none;
    font-weight: 600;
  }
  .botones-fuente a:hover { background: var(--oro); border-color: var(--oro); }
  .nota-enlace { margin-top: 1rem; font-size: 0.86rem; color: var(--bruma); }

  .acciones { margin-top: 2.5rem; padding-top: 1.2rem; border-top: 1px solid var(--oro); display: flex; justify-content: center; }

  dialog { width: min(94vw, 70rem); max-height: 90vh; margin: auto; border: 1px solid var(--oro); background: #05080c; overflow: hidden; }
  dialog::backdrop { background: rgb(8 14 22 / 0.94); }
  .lienzo { height: min(78vh, 48rem); overflow: hidden; touch-action: none; display: grid; place-items: center; }
  .lienzo img { max-width: 100%; max-height: 100%; transform-origin: center; user-select: none; cursor: zoom-in; will-change: transform; }
  .lienzo img.ampliada { cursor: grab; }
  .lienzo img.arrastrando { cursor: grabbing; }
  .cerrar { position: absolute; right: 0.6rem; top: 0.6rem; z-index: 3; min-width: 84px; height: 44px; min-height: 44px; font-size: 14px; padding: 0 0.75rem; border: 1px solid var(--oro-claro); border-radius: 2rem; background: var(--noche); color: var(--papel); cursor: pointer; }
  .controles { position: absolute; left: 50%; bottom: 0.8rem; transform: translateX(-50%); display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; }
  .controles button,
  .controles a { min-width: 88px; height: 44px; min-height: 44px; padding: 0 12px; border-radius: 22px; border: 1px solid var(--oro-claro); background: var(--noche); color: var(--papel); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; font-size: 13px; }
  .controles output { min-width: 64px; height: 44px; min-height: 44px; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; color: var(--papel); font-weight: 700; }

  @media (max-width: 700px) {
    .parallel { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 620px) {
    .documentacion dl > div { grid-template-columns: 1fr; gap: 0.25rem; }
    .abrir-lupa { inset: auto 0.7rem 0.7rem auto; }
    .flecha { width: 40px; height: 40px; min-height: 40px; font-size: 20px; }
    .flecha-izq { left: 0.3rem; }
    .flecha-der { right: 0.3rem; }
    .controles { width: calc(100% - 1rem); justify-content: center; gap: 0.3rem; }
    .controles button,
    .controles a { min-width: 0; flex: 1 1 auto; padding-inline: 6px; font-size: 12px; }
    .controles output { min-width: 52px; font-size: 13px; }
    .botones-fuente { flex-direction: column; }
  }
</style>

<script>
  document.querySelectorAll('[data-galeria]').forEach((galeria) => {
    const principal = galeria.querySelector('[data-principal]') as HTMLImageElement;
    const pie = galeria.querySelector('[data-pie]') as HTMLElement;
    const contador = galeria.querySelector('[data-contador]') as HTMLElement;
    const miniaturas = Array.from(galeria.querySelectorAll('[data-miniatura]')) as HTMLButtonElement[];
    const visor = galeria.querySelector('[data-visor]') as HTMLDialogElement;
    const lienzo = galeria.querySelector('[data-lienzo]') as HTMLElement;
    const visorImg = galeria.querySelector('[data-visor-img]') as HTMLImageElement;
    const salidaZoom = galeria.querySelector('[data-zoom]') as HTMLOutputElement;
    const original = galeria.querySelector('[data-original]') as HTMLAnchorElement;
    let indiceActivo = 0;
    let escala = 1;
    let desplazamientoX = 0;
    let desplazamientoY = 0;
    let arrastrando = false;
    let inicioX = 0;
    let inicioY = 0;

    const limitarDesplazamiento = () => {
      const maxX = lienzo.clientWidth * Math.max(0, escala - 1) / 2;
      const maxY = lienzo.clientHeight * Math.max(0, escala - 1) / 2;
      desplazamientoX = Math.max(-maxX, Math.min(maxX, desplazamientoX));
      desplazamientoY = Math.max(-maxY, Math.min(maxY, desplazamientoY));
    };

    const aplicar = () => {
      if (escala <= 1) {
        escala = 1;
        desplazamientoX = 0;
        desplazamientoY = 0;
      }
      limitarDesplazamiento();
      visorImg.style.transform = `translate3d(${desplazamientoX}px, ${desplazamientoY}px, 0) scale(${escala})`;
      visorImg.classList.toggle('ampliada', escala > 1);
      salidaZoom.textContent = `${Math.round(escala * 100)} %`;
    };

    const restablecer = () => {
      escala = 1;
      desplazamientoX = 0;
      desplazamientoY = 0;
      aplicar();
    };

    const activar = (indice: number) => {
      if (!miniaturas.length) return;
      indiceActivo = (indice + miniaturas.length) % miniaturas.length;
      const boton = miniaturas[indiceActivo];
      miniaturas.forEach((b) => b.classList.remove('activa'));
      boton.classList.add('activa');
      principal.src = boton.dataset.src || '';
      principal.alt = boton.dataset.alt || '';
      pie.textContent = boton.dataset.pie || '';
      contador.textContent = `Página ${indiceActivo + 1} de ${miniaturas.length}`;
      original.href = boton.dataset.src || '';
      if (visor.open) {
        visorImg.src = boton.dataset.src || '';
        visorImg.alt = boton.dataset.alt || '';
        restablecer();
      }
    };

    miniaturas.forEach((boton, indice) => boton.addEventListener('click', () => activar(indice)));
    galeria.querySelector('[data-anterior]')?.addEventListener('click', () => activar(indiceActivo - 1));
    galeria.querySelector('[data-siguiente]')?.addEventListener('click', () => activar(indiceActivo + 1));
    galeria.querySelector('[data-visor-anterior]')?.addEventListener('click', () => activar(indiceActivo - 1));
    galeria.querySelector('[data-visor-siguiente]')?.addEventListener('click', () => activar(indiceActivo + 1));

    galeria.querySelector('[data-ampliar]')?.addEventListener('click', () => {
      visorImg.src = principal.src;
      visorImg.alt = principal.alt;
      original.href = principal.src;
      restablecer();
      visor.showModal();
    });
    galeria.querySelector('[data-cerrar]')?.addEventListener('click', () => visor.close());
    galeria.querySelector('[data-mas]')?.addEventListener('click', () => { escala = Math.min(5, escala * 1.5); aplicar(); });
    galeria.querySelector('[data-menos]')?.addEventListener('click', () => { escala = Math.max(1, escala / 1.5); aplicar(); });
    galeria.querySelector('[data-restablecer]')?.addEventListener('click', restablecer);
    visor.addEventListener('click', (e) => { if (e.target === visor) visor.close(); });
    visor.addEventListener('keydown', (e) => {
      if (e.key === '+' || e.key === '=') { escala = Math.min(5, escala * 1.5); aplicar(); }
      if (e.key === '-') { escala = Math.max(1, escala / 1.5); aplicar(); }
      if (e.key === '0') restablecer();
      if (e.key === 'ArrowLeft') activar(indiceActivo - 1);
      if (e.key === 'ArrowRight') activar(indiceActivo + 1);
    });

    lienzo.addEventListener('wheel', (e) => {
      e.preventDefault();
      escala = Math.max(1, Math.min(5, escala * (e.deltaY < 0 ? 1.2 : 1 / 1.2)));
      aplicar();
    }, { passive: false });

    visorImg.addEventListener('dblclick', () => {
      escala = escala > 1 ? 1 : 2;
      aplicar();
    });
    visorImg.addEventListener('pointerdown', (e) => {
      if (escala <= 1) return;
      arrastrando = true;
      inicioX = e.clientX - desplazamientoX;
      inicioY = e.clientY - desplazamientoY;
      visorImg.classList.add('arrastrando');
      visorImg.setPointerCapture(e.pointerId);
    });
    visorImg.addEventListener('pointermove', (e) => {
      if (!arrastrando) return;
      desplazamientoX = e.clientX - inicioX;
      desplazamientoY = e.clientY - inicioY;
      aplicar();
    });
    const terminarArrastre = () => {
      arrastrando = false;
      visorImg.classList.remove('arrastrando');
    };
    visorImg.addEventListener('pointerup', terminarArrastre);
    visorImg.addEventListener('pointercancel', terminarArrastre);
  });
</script>

---
import Base from '../../layouts/Base.astro';
import { documentos, notasHistoricasEnsayo } from '../../data/archivo';

export function getStaticPaths() {
  return documentos.map((d) => ({ params: { slug: d.slug }, props: { documento: d } }));
}
const { documento } = Astro.props;
const esEnsayo = documento.slug === 'ensayo-espana';
---
<Base titulo={documento.titulo} descripcion={`${documento.titulo}: documento original y su traducción al español.`} conBarco={true}>
  <main class="detalle-archivo">
    <nav class="migas" aria-label="Ruta">
      <a href="/archivo">Todo el archivo</a>
    </nav>

    <header>
      <p class="etiqueta">{documento.pieza}</p>
      <h1 class="display">{documento.titulo}</h1>
      <p class="fecha-cabecera">{documento.fecha}</p>
      <p>{documento.resumen}</p>
    </header>

    <section class="visor" data-visor data-total={documento.paginas.length} aria-label={`Páginas de ${documento.titulo}`}>
      <div class="barra-paginas">
        <p class="posicion" aria-live="polite"><span data-titulo-pagina>{documento.paginas[0].titulo}</span><span class="referencia" data-referencia>{documento.paginas[0].referencia}</span></p>
        <div class="pasos">
          <button type="button" data-anterior disabled>‹ Anterior</button>
          <span class="contador" data-contador>1 / {documento.paginas.length}</span>
          <button type="button" data-siguiente disabled={documento.paginas.length === 1}>Siguiente ›</button>
        </div>
      </div>

      {documento.paginas.length > 1 && (
        <div class="salto">
          <label for={`ir-a-${documento.slug}`}>Ir a</label>
          <select id={`ir-a-${documento.slug}`} data-salto>
            {documento.paginas.map((p, i) => <option value={i}>{i + 1}. {p.titulo}</option>)}
          </select>
        </div>
      )}

      <div class="pestanas" role="tablist" aria-label="Forma de consultar la página">
        <button role="tab" type="button" aria-selected="true" data-vista="paralela">Paralela</button>
        <button role="tab" type="button" aria-selected="false" data-vista="original">Original</button>
        <button role="tab" type="button" aria-selected="false" data-vista="traduccion">Traducción</button>
        <button role="tab" type="button" aria-selected="false" data-vista="transcripcion">Transcripción</button>
        <button role="tab" type="button" aria-selected="false" data-vista="notas">Notas editoriales</button>
      </div>

      {documento.paginas.map((pagina, i) => (
        <div class="pagina" data-pagina={i} data-titulo={pagina.titulo} data-referencia={pagina.referencia} hidden={i !== 0}>
          <div class="panel" data-panel="paralela">
            <div class="par">
              <article class="tarjeta">
                <div class="tarjeta-cabecera"><h2>Original</h2><span>Escaneo del expediente</span></div>
                <div class="marco-escaneo">
                  <button type="button" data-ampliar={i} aria-label={`Ampliar el escaneo de ${pagina.titulo}`}>
                    <img src={pagina.src} alt={pagina.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                    <span class="abrir-lupa">Ampliar</span>
                  </button>
                </div>
              </article>
              <article class="tarjeta">
                <div class="tarjeta-cabecera"><h2>Traducción</h2><span>Edición familiar, 2026</span></div>
                <div class="traduccion"><p class="aviso-traduccion">Traducción al español · no es el documento original</p>{pagina.traduccion}</div>
              </article>
            </div>
          </div>

          <div class="panel" data-panel="original" hidden>
            <article class="tarjeta">
              <div class="marco-escaneo amplio">
                <button type="button" data-ampliar={i} aria-label={`Ampliar el escaneo de ${pagina.titulo}`}>
                  <img src={pagina.src} alt={pagina.alt} loading="lazy" decoding="async" />
                  <span class="abrir-lupa">Ampliar</span>
                </button>
              </div>
            </article>
          </div>

          <div class="panel" data-panel="traduccion" hidden>
            <article class="tarjeta">
              <div class="traduccion sola"><p class="aviso-traduccion">Traducción al español · no es el documento original</p>{pagina.traduccion}</div>
            </article>
          </div>

          <div class="panel" data-panel="transcripcion" hidden>
            <article class="tarjeta">
              <div class="transcripcion">
                <p class="aviso-traduccion">Transcripción literal del inglés · se conservan sus erratas</p>
                <pre>{pagina.original}</pre>
              </div>
            </article>
          </div>

          <div class="panel" data-panel="notas" hidden>
            <article class="tarjeta">
              <div class="notas">
                <p class="aviso-traduccion">Aparato crítico · añadido en 2026, no pertenece al documento</p>
                {pagina.notas.length === 0 ? (
                  <p class="sin-notas">Esta página no presentó dudas de lectura ni decisiones de traducción que anotar.</p>
                ) : (
                  <ul>
                    {pagina.notas.map((n) => (
                      <li>
                        <p>{n.texto}</p>
                        {n.fuenteUrl && <a href={n.fuenteUrl} target="_blank" rel="noopener">Fuente: {n.fuenteTexto} ↗</a>}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          </div>
        </div>
      ))}

      <dialog data-visor-foto aria-label="Página ampliada">
        <button class="cerrar" type="button" data-cerrar>Cerrar ✕</button>
        <div class="lienzo" data-lienzo><img src="" alt="" data-imagen-visor draggable="false" /></div>
        <div class="controles" role="group" aria-label="Controles de ampliación">
          <button type="button" data-menos aria-label="Alejar">− Alejar</button>
          <button type="button" data-restablecer>Ajustar</button>
          <output data-zoom aria-live="polite">100 %</output>
          <button type="button" data-mas aria-label="Acercar">+ Acercar</button>
        </div>
      </dialog>
    </section>

    <section class="documentacion" aria-labelledby="titulo-documentacion">
      <h2 id="titulo-documentacion">Ficha documental</h2>
      <dl>
        <div><dt>Tipo de documento</dt><dd>{documento.tipoDocumento}</dd></div>
        <div><dt>Contexto</dt><dd>{documento.contexto}</dd></div>
        <div><dt>Personas documentadas</dt><dd><ul>{documento.personas.map((p) => <li>{p}</li>)}</ul></dd></div>
        <div><dt>Procedencia</dt><dd>{documento.fuenteTexto}</dd></div>
        <div><dt>Crédito</dt><dd>{documento.credito}</dd></div>
        <div><dt>Derechos y uso</dt><dd>{documento.derechos}</dd></div>
        <div><dt>Fecha de consulta</dt><dd>{documento.fechaConsulta}</dd></div>
      </dl>
    </section>

    {esEnsayo && notasHistoricasEnsayo.length > 0 && (
      <section class="contexto-historico" aria-labelledby="titulo-contexto">
        <h2 id="titulo-contexto">Lo que el expediente cuenta alrededor del texto</h2>
        <p class="intro-contexto">Contexto verificado con fuentes externas. No pertenece al ensayo de Tomás ni altera lo que él escribió.</p>
        <div class="tarjetas-contexto">
          {notasHistoricasEnsayo.map((n) => (
            <article>
              <p>{n.texto}</p>
              {n.fuenteUrl && <a href={n.fuenteUrl} target="_blank" rel="noopener">Fuente: {n.fuenteTexto} ↗</a>}
            </article>
          ))}
        </div>
      </section>
    )}

    <nav class="acciones" aria-label="Continuar">
      <a href="/archivo">Volver a todo el archivo</a>
    </nav>
  </main>
</Base>

<style>
  .detalle-archivo { max-width: 66rem; margin: 0 auto; padding: 5.8rem 1.4rem 3rem; }
  .migas { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.5rem 1rem; }
  .migas a, .acciones a { min-height: 2.75rem; display: inline-flex; align-items: center; }
  header { text-align: center; max-width: 42rem; margin: 1.2rem auto 2.4rem; }
  h1 { font-size: clamp(1.9rem, 6vw, 2.9rem); margin: 0.3rem 0 0.4rem; }
  .fecha-cabecera { font-weight: 700; color: var(--marino); margin-bottom: 0.6rem; }

  .barra-paginas { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; padding-bottom: 0.9rem; border-bottom: 1px solid var(--oro); }
  .posicion { display: grid; gap: 0.1rem; }
  .posicion span:first-child { font-family: var(--f-display); font-size: 1.35rem; color: var(--marino); }
  .referencia { color: var(--bruma); font-size: 0.8rem; }
  .pasos { display: flex; align-items: center; gap: 0.5rem; }
  .pasos button {
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--marino);
    background: var(--papel-2);
    color: var(--marino);
    font: 600 14px/1 var(--f-cuerpo);
    cursor: pointer;
  }
  .pasos button:hover:not(:disabled) { background: var(--marino); color: var(--papel); }
  .pasos button:disabled { opacity: 0.4; cursor: not-allowed; }
  .contador { min-width: 62px; text-align: center; font-size: 14px; font-weight: 700; color: var(--bruma); }

  .salto { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.9rem; }
  .salto label { font-size: 14px; font-weight: 700; color: var(--marino); }
  .salto select { flex: 1 1 auto; min-height: 44px; max-width: 32rem; padding: 0 10px; border: 1px solid var(--oro); background: var(--papel-2); color: var(--tinta); font: 14px/1.3 var(--f-cuerpo); }

  .pestanas { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1.2rem 0; }
  .pestanas button {
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid color-mix(in srgb, var(--oro) 70%, transparent);
    background: transparent;
    color: var(--marino);
    font: 600 14px/1 var(--f-cuerpo);
    cursor: pointer;
  }
  .pestanas button[aria-selected='true'] { background: var(--marino); border-color: var(--marino); color: var(--papel); }

  .par { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.2rem; align-items: start; }
  .tarjeta { border: 1px solid color-mix(in srgb, var(--oro) 60%, transparent); background: var(--papel-2); min-width: 0; }
  .tarjeta-cabecera { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 0.75rem 0.9rem; border-bottom: 1px solid color-mix(in srgb, var(--oro) 40%, transparent); }
  .tarjeta-cabecera h2 { font-family: var(--f-display); font-size: 1.25rem; color: var(--marino); }
  .tarjeta-cabecera span { color: var(--bruma); font-size: 0.72rem; font-variant-caps: all-small-caps; letter-spacing: 0.1em; }

  .marco-escaneo { display: grid; place-items: center; padding: 0.7rem; }
  .marco-escaneo button { position: relative; width: 100%; border: 0; padding: 0; background: none; cursor: zoom-in; }
  .marco-escaneo img { display: block; width: 100%; max-height: 62vh; object-fit: contain; background: #fff; }
  .marco-escaneo.amplio img { max-height: 82vh; }
  .abrir-lupa {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 12px;
    border: 1px solid var(--oro-claro);
    background: rgb(14 26 40 / 0.92);
    color: var(--papel);
    font: 600 13px/1.2 var(--f-cuerpo);
  }

  /* La traducción imita el aire mecanografiado del original, en español legible. */
  .traduccion {
    padding: 1.2rem 1.1rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.9rem;
    line-height: 1.62;
    color: var(--tinta);
  }
  .traduccion.sola { padding: 1.5rem clamp(1rem, 4vw, 2.4rem); }
  .aviso-traduccion {
    margin-bottom: 1.1rem;
    color: var(--oro);
    font: 700 0.68rem/1.3 var(--f-cuerpo);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
  }
  .transcripcion { padding: 1.5rem clamp(1rem, 4vw, 2.4rem); }
  .transcripcion pre { white-space: pre-wrap; overflow-wrap: anywhere; font: 0.84rem/1.6 'Courier New', Courier, monospace; color: var(--tinta); }

  .notas { padding: 1.5rem clamp(1rem, 4vw, 2.4rem); }
  .notas ul { display: grid; gap: 0.9rem; margin: 0; padding: 0; list-style: none; }
  .notas li { padding: 0.9rem 1rem; border: 1px solid color-mix(in srgb, var(--oro) 40%, transparent); border-top: 3px solid var(--oro); background: var(--papel); }
  .notas li p { font-size: 0.94rem; }
  .notas li a { display: inline-block; margin-top: 0.55rem; font-size: 0.78rem; font-weight: 700; }
  .sin-notas { color: var(--bruma); font-style: italic; }

  .documentacion { margin: 3rem auto 0; max-width: 46rem; }
  .documentacion h2 { font-family: var(--f-display); color: var(--marino); text-align: center; font-size: 1.55rem; margin-bottom: 1rem; }
  .documentacion dl { border-top: 1px solid var(--oro); }
  .documentacion dl > div { display: grid; grid-template-columns: minmax(10rem, 0.8fr) minmax(0, 2fr); gap: 1rem 1.4rem; padding: 0.9rem 0; border-bottom: 1px solid color-mix(in srgb, var(--oro) 45%, transparent); }
  .documentacion dt { font-weight: 700; color: var(--marino); }
  .documentacion dd { margin: 0; }
  .documentacion ul { margin: 0; padding-left: 1.2rem; }

  .contexto-historico { margin: 3rem auto 0; max-width: 58rem; }
  .contexto-historico h2 { font-family: var(--f-display); color: var(--marino); text-align: center; font-size: 1.55rem; }
  .intro-contexto { max-width: 38rem; margin: 0.6rem auto 1.4rem; text-align: center; color: var(--bruma); font-size: 0.92rem; }
  .tarjetas-contexto { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: 1rem; }
  .tarjetas-contexto article { padding: 1.1rem; border: 1px solid color-mix(in srgb, var(--oro) 45%, transparent); border-top: 3px solid var(--oro); background: var(--papel-2); }
  .tarjetas-contexto p { font-size: 0.92rem; }
  .tarjetas-contexto a { display: inline-block; margin-top: 0.6rem; font-size: 0.78rem; font-weight: 700; }

  .acciones { margin-top: 2.5rem; padding-top: 1.2rem; border-top: 1px solid var(--oro); display: flex; justify-content: center; }

  dialog { width: min(94vw, 70rem); max-height: 90vh; margin: auto; border: 1px solid var(--oro); background: #05080c; overflow: hidden; }
  dialog::backdrop { background: rgb(8 14 22 / 0.94); }
  .lienzo { height: min(78vh, 48rem); overflow: hidden; touch-action: none; display: grid; place-items: center; }
  .lienzo img { max-width: 100%; max-height: 100%; transform-origin: center; user-select: none; cursor: zoom-in; will-change: transform; }
  .lienzo img.ampliada { cursor: grab; }
  .lienzo img.arrastrando { cursor: grabbing; }
  .cerrar { position: absolute; right: 0.6rem; top: 0.6rem; z-index: 3; min-width: 84px; height: 44px; min-height: 44px; font-size: 14px; padding: 0 0.75rem; border: 1px solid var(--oro-claro); border-radius: 2rem; background: var(--noche); color: var(--papel); cursor: pointer; }
  .controles { position: absolute; left: 50%; bottom: 0.8rem; transform: translateX(-50%); display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; }
  .controles button { min-width: 88px; height: 44px; min-height: 44px; padding: 0 12px; border-radius: 22px; border: 1px solid var(--oro-claro); background: var(--noche); color: var(--papel); cursor: pointer; font-size: 13px; }
  .controles output { min-width: 64px; height: 44px; display: inline-flex; align-items: center; justify-content: center; color: var(--papel); font-weight: 700; font-size: 14px; }

  @media (max-width: 860px) {
    .par { grid-template-columns: 1fr; }
    .marco-escaneo img { max-height: 52vh; }
  }
  @media (max-width: 620px) {
    .documentacion dl > div { grid-template-columns: 1fr; gap: 0.25rem; }
    .barra-paginas { justify-content: center; text-align: center; }
    .pasos { width: 100%; justify-content: space-between; }
    .pestanas button { flex: 1 1 42%; padding-inline: 6px; font-size: 13px; }
    .controles { width: calc(100% - 1rem); gap: 0.3rem; }
    .controles button { min-width: 0; flex: 1 1 auto; padding-inline: 6px; font-size: 12px; }
  }
</style>

<script>
  document.querySelectorAll('[data-visor]').forEach((visor) => {
    const paginas = Array.from(visor.querySelectorAll('[data-pagina]')) as HTMLElement[];
    const pestanas = Array.from(visor.querySelectorAll('[data-vista]')) as HTMLButtonElement[];
    const tituloPagina = visor.querySelector('[data-titulo-pagina]') as HTMLElement;
    const referencia = visor.querySelector('[data-referencia]') as HTMLElement;
    const contador = visor.querySelector('[data-contador]') as HTMLElement;
    const anterior = visor.querySelector('[data-anterior]') as HTMLButtonElement;
    const siguiente = visor.querySelector('[data-siguiente]') as HTMLButtonElement;
    const salto = visor.querySelector('[data-salto]') as HTMLSelectElement | null;
    const dialogo = visor.querySelector('[data-visor-foto]') as HTMLDialogElement;
    const lienzo = visor.querySelector('[data-lienzo]') as HTMLElement;
    const imagenVisor = visor.querySelector('[data-imagen-visor]') as HTMLImageElement;
    const salidaZoom = visor.querySelector('[data-zoom]') as HTMLOutputElement;

    let indice = 0;
    let vista = 'paralela';
    let escala = 1;
    let x = 0;
    let y = 0;
    let arrastrando = false;
    let inicioX = 0;
    let inicioY = 0;

    const mostrarVista = () => {
      paginas.forEach((pagina) => {
        pagina.querySelectorAll('[data-panel]').forEach((panel) => {
          (panel as HTMLElement).hidden = (panel as HTMLElement).dataset.panel !== vista;
        });
      });
      pestanas.forEach((boton) => boton.setAttribute('aria-selected', String(boton.dataset.vista === vista)));
    };

    // Las imágenes nacen en `loading="lazy"` dentro de páginas ocultas, y el
    // navegador nunca llega a dispararlas al mostrarlas: hay que forzarlas.
    const cargarImagenes = (pagina: HTMLElement | undefined) => {
      pagina?.querySelectorAll('img[loading="lazy"]').forEach((img) => {
        (img as HTMLImageElement).loading = 'eager';
      });
    };

    const mostrarPagina = (nuevo: number) => {
      indice = Math.max(0, Math.min(paginas.length - 1, nuevo));
      paginas.forEach((pagina, i) => { pagina.hidden = i !== indice; });
      cargarImagenes(paginas[indice]);
      cargarImagenes(paginas[indice + 1]);
      const actual = paginas[indice];
      tituloPagina.textContent = actual.dataset.titulo || '';
      referencia.textContent = actual.dataset.referencia || '';
      contador.textContent = `${indice + 1} / ${paginas.length}`;
      anterior.disabled = indice === 0;
      siguiente.disabled = indice === paginas.length - 1;
      if (salto) salto.value = String(indice);
    };

    pestanas.forEach((boton) => boton.addEventListener('click', () => {
      vista = boton.dataset.vista || 'paralela';
      mostrarVista();
    }));

    anterior.addEventListener('click', () => mostrarPagina(indice - 1));
    siguiente.addEventListener('click', () => mostrarPagina(indice + 1));
    salto?.addEventListener('change', () => mostrarPagina(Number(salto.value)));

    // Flechas del teclado, salvo mientras se escribe en un control de formulario.
    document.addEventListener('keydown', (e) => {
      if (dialogo.open) return;
      const activo = document.activeElement?.tagName;
      if (activo === 'SELECT' || activo === 'INPUT' || activo === 'TEXTAREA') return;
      if (e.key === 'ArrowLeft') mostrarPagina(indice - 1);
      if (e.key === 'ArrowRight') mostrarPagina(indice + 1);
    });

    const limitar = () => {
      const maxX = lienzo.clientWidth * Math.max(0, escala - 1) / 2;
      const maxY = lienzo.clientHeight * Math.max(0, escala - 1) / 2;
      x = Math.max(-maxX, Math.min(maxX, x));
      y = Math.max(-maxY, Math.min(maxY, y));
    };
    const aplicar = () => {
      if (escala <= 1) { escala = 1; x = 0; y = 0; }
      limitar();
      imagenVisor.style.transform = `translate3d(${x}px, ${y}px, 0) scale(${escala})`;
      imagenVisor.classList.toggle('ampliada', escala > 1);
      salidaZoom.textContent = `${Math.round(escala * 100)} %`;
    };
    const restablecer = () => { escala = 1; x = 0; y = 0; aplicar(); };

    visor.querySelectorAll('[data-ampliar]').forEach((boton) => boton.addEventListener('click', () => {
      const img = boton.querySelector('img') as HTMLImageElement;
      imagenVisor.src = img.src;
      imagenVisor.alt = img.alt;
      restablecer();
      dialogo.showModal();
    }));
    visor.querySelector('[data-cerrar]')?.addEventListener('click', () => dialogo.close());
    visor.querySelector('[data-mas]')?.addEventListener('click', () => { escala = Math.min(5, escala * 1.5); aplicar(); });
    visor.querySelector('[data-menos]')?.addEventListener('click', () => { escala = Math.max(1, escala / 1.5); aplicar(); });
    visor.querySelector('[data-restablecer]')?.addEventListener('click', restablecer);
    dialogo.addEventListener('click', (e) => { if (e.target === dialogo) dialogo.close(); });
    dialogo.addEventListener('keydown', (e) => {
      if (e.key === '+' || e.key === '=') { escala = Math.min(5, escala * 1.5); aplicar(); }
      if (e.key === '-') { escala = Math.max(1, escala / 1.5); aplicar(); }
      if (e.key === '0') restablecer();
    });
    lienzo.addEventListener('wheel', (e) => {
      e.preventDefault();
      escala = Math.max(1, Math.min(5, escala * (e.deltaY < 0 ? 1.2 : 1 / 1.2)));
      aplicar();
    }, { passive: false });
    imagenVisor.addEventListener('dblclick', () => { escala = escala > 1 ? 1 : 2; aplicar(); });
    imagenVisor.addEventListener('pointerdown', (e) => {
      if (escala <= 1) return;
      arrastrando = true;
      inicioX = e.clientX - x;
      inicioY = e.clientY - y;
      imagenVisor.classList.add('arrastrando');
      imagenVisor.setPointerCapture(e.pointerId);
    });
    imagenVisor.addEventListener('pointermove', (e) => {
      if (!arrastrando) return;
      x = e.clientX - inicioX;
      y = e.clientY - inicioY;
      aplicar();
    });
    const terminar = () => { arrastrando = false; imagenVisor.classList.remove('arrastrando'); };
    imagenVisor.addEventListener('pointerup', terminar);
    imagenVisor.addEventListener('pointercancel', terminar);

    mostrarVista();
    mostrarPagina(0);
  });
</script>

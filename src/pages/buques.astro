---
import Base from '../layouts/Base.astro';
import { buques } from '../data/buques';
---
<Base titulo="Los buques" descripcion="Los buques y episodios navales de las memorias de Tomás Gómez Arroyo, reunidos en galerías fotográficas." conBarco={true}>
  <main class="flota">
    <header>
      <p class="etiqueta">La flota de una vida</p>
      <h1 class="display">Los buques</h1>
      <p class="intro">Pulse un buque para abrir su galería, ampliar las fotografías y observar sus detalles. Las maquetas y los buques gemelos están rotulados expresamente.</p>
    </header>

    <div class="fichas">
      {buques.map((b) => (
        <article class="ficha">
          <a href={`/buques/${b.slug}`} class={`marco-foto ${b.imagenes.length ? '' : 'sin-foto'}`} aria-label={`Abrir la galería del ${b.nombre}`}>
            {b.imagenes.length
              ? <img src={b.imagenes[0].src} alt={b.imagenes[0].alt} loading="lazy" decoding="async" />
              : <span>Fotografías<br />en preparación</span>}
            {b.imagenes.length > 0 && <span class="cantidad">{b.imagenes.length} {b.imagenes.length === 1 ? 'foto' : 'fotos'}</span>}
          </a>
          <h2><a href={`/buques/${b.slug}`}>{b.nombre}</a></h2>
          <p class="tipo etiqueta">{b.tipo} · {b.anos}</p>
          <p class="nota">{b.nota}</p>
          <p class="acciones"><a class="boton-ficha" href={`/buques/${b.slug}`}>{b.imagenes.length ? 'Abrir galería y lupa' : 'Ver ficha pendiente'}</a><a href={`/capitulo/${b.cap}`}>Leer el episodio</a></p>
        </article>
      ))}
    </div>
  </main>
</Base>

<style>
  .flota { max-width: 62rem; margin: 0 auto; padding: 5.5rem 1.4rem 3rem; }
  header { text-align: center; margin-bottom: 3rem; }
  h1 { font-size: clamp(2.1rem, 6vw, 3rem); margin-top: 0.5rem; }
  .intro { max-width: 38rem; margin: 1.2rem auto 0; color: var(--tinta); }
  .fichas { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: 2.8rem 2.2rem; }
  .ficha { display: flex; flex-direction: column; }
  .marco-foto {
    position: relative;
    display: block;
    border: 1px solid color-mix(in srgb, var(--oro) 55%, transparent);
    padding: 6px;
    background: var(--papel-2);
    box-shadow: 0 1px 8px rgb(0 0 0 / 0.08);
  }
  .cantidad {
    position: absolute;
    right: 0.65rem;
    bottom: 0.65rem;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--oro-claro);
    border-radius: 2rem;
    background: rgb(14 26 40 / 0.9);
    color: var(--papel);
    font: 600 0.78rem/1.2 var(--f-cuerpo);
  }
  .marco-foto img { display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .sin-foto {
    aspect-ratio: 3 / 2;
    display: grid;
    place-items: center;
    text-align: center;
    color: var(--bruma);
    font-family: var(--f-display);
    font-style: italic;
    background: repeating-linear-gradient(45deg, transparent 0 10px, rgb(0 0 0 / 0.025) 10px 20px), var(--papel-2);
  }
  h2 { font-family: var(--f-display); font-weight: 600; font-size: 1.55rem; margin-top: 0.9rem; }
  h2 a { text-decoration: none; }
  .tipo { margin-top: 0.1rem; }
  .nota { margin-top: 0.5rem; font-size: 0.98rem; }
  .acciones { margin-top: auto; padding-top: 0.8rem; display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; }
  .acciones a { min-height: 2.75rem; display: inline-flex; align-items: center; font-size: 0.92rem; }
  .acciones .boton-ficha {
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--marino);
    background: var(--marino);
    color: var(--papel);
    text-decoration: none;
  }
  .acciones .boton-ficha:hover { background: var(--oro); border-color: var(--oro); color: var(--papel); }
</style>

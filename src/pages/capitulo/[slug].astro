---
import Base from '../../layouts/Base.astro';
import RecuerdosCapitulo from '../../components/RecuerdosCapitulo.astro';
import indice from '../../generado/indice.json';
import narracionDisponible from '../../generado/narracion.json';

export async function getStaticPaths() {
  return indice.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const cap = indice.find((c) => c.slug === slug);
const i = indice.findIndex((c) => c.slug === slug);
const anterior = i > 0 ? indice[i - 1] : null;
const siguiente = i < indice.length - 1 ? indice[i + 1] : null;

const tieneAudio = narracionDisponible.includes(slug);
const versionAudio = slug === 'capitulo-primero' || slug === 'capitulo-octavo'
  ? '?v=20260824'
  : slug === 'capitulo-segundo' ? '?v=20260823' : '';
const audioSrc = `/media/narracion/${slug}.mp3${versionAudio}`;
const siguienteConAudio = siguiente && narracionDisponible.includes(siguiente.slug) ? siguiente : null;

const fragmentos = import.meta.glob('../../generado/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const cuerpo = fragmentos[`../../generado/${slug}.html`];
const tieneEnlacesDeTexto = cuerpo.includes('enlace-foto');
---
<Base titulo={cap.titulo} descripcion={cap.resumen} conBarco={true}>
  <main class="capitulo">
    <nav class="herramientas-lectura" aria-label="Herramientas de lectura">
      <div class="fila-superior">
        <a href="/">Memorias</a>
        <span class="posicion">Parte {i + 1} de {indice.length}</span>
        <button type="button" id="continuar-lectura" hidden>Continuar donde me quedé</button>
        <button type="button" id="imprimir-capitulo">Imprimir</button>
      </div>
      {tieneAudio && (
        <div class="fila-inferior">
          <button
            type="button"
            id="reproducir-narracion"
            data-audio={audioSrc}
            data-titulo={cap.titulo}
            data-siguiente={siguienteConAudio ? `/capitulo/${siguienteConAudio.slug}` : ''}
          >
            ▶ Escuchar
          </button>
          <label class="control-velocidad">
            Velocidad
            <select id="velocidad-narracion" aria-label="Velocidad de lectura">
              <option value="1">1×</option>
              <option value="1.2">1,2×</option>
              <option value="1.5">1,5×</option>
              <option value="2">2×</option>
            </select>
          </label>

        </div>
      )}
    </nav>
    <header>
      <p class="etiqueta">{cap.periodo} · {cap.lugares}</p>
      <h1 class="display">{cap.titulo}</h1>
      {cap.subtitulo && <p class="subtitulo">{cap.subtitulo}</p>}
      <div class="filete-ancla" aria-hidden="true">⚓</div>
    </header>

    {cap.aviso && <aside class="aviso-contenido" aria-label="Aviso sobre el contenido">{cap.aviso}</aside>}

    {tieneEnlacesDeTexto && (
      <p class="ayuda-enlaces">Las palabras marcadas así <span class="icono-foto" aria-hidden="true">📷</span> se pueden pulsar: abren una fotografía sin cambiar de página.</p>
    )}

    <div class="texto" set:html={cuerpo} />

    <dialog id="visor" aria-label="Fotografía ampliada">
      <button type="button" id="visor-cerrar" aria-label="Cerrar">✕</button>
      <div id="visor-cuerpo">
        <div id="visor-lienzo">
          <img id="visor-img" src="" alt="" draggable="false" />
          <p id="visor-ayuda">Haz clic o toca la foto para acercarte. Arrastra para moverte.</p>
          <div id="visor-zoom" role="group" aria-label="Acercar o alejar la fotografía">
            <button type="button" id="zoom-menos" aria-label="Alejar">−</button>
            <button type="button" id="zoom-reset" aria-label="Ajustar el zoom al tamaño de pantalla">⤢</button>
            <button type="button" id="zoom-mas" aria-label="Acercar">+</button>
            <a href="#" target="_blank" rel="noopener" id="visor-original" aria-label="Ver la fotografía a tamaño original en una pestaña nueva">↗</a>
          </div>
        </div>
        <aside id="visor-ficha" hidden>
          <p class="etiqueta">Ficha</p>
          <h2 id="ficha-titulo"></h2>
          <ul id="ficha-datos"></ul>
          <p id="ficha-historia"></p>
          <p id="ficha-credito" class="credito"></p>
          <a id="ficha-galeria" class="ver-galeria" href="#" hidden>Ver más fotografías &rarr;</a>
        </aside>
      </div>
    </dialog>

    <RecuerdosCapitulo slug={slug} />

    <nav class="rumbos" aria-label="Capítulos vecinos">
      {anterior
        ? <a rel="prev" href={`/capitulo/${anterior.slug}`}><span class="etiqueta">Anterior</span><span>{anterior.titulo}</span></a>
        : <span />}
      {siguiente
        ? <a rel="next" href={`/capitulo/${siguiente.slug}`}><span class="etiqueta">Siguiente</span><span>{siguiente.titulo}</span></a>
        : <a rel="next" href="/epilogo"><span class="etiqueta">Siguiente</span><span>El resto de la travesía</span></a>}
    </nav>
  </main>
</Base>

<style>
  .capitulo {
    max-width: var(--medida);
    margin: 0 auto;
    padding: 5.5rem 1.4rem 3rem;
  }
  .herramientas-lectura {
    position: sticky;
    top: 3.7rem;
    z-index: 40;
    margin: 0 auto 2rem;
    padding: 0.35rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    background: color-mix(in srgb, var(--papel) 94%, transparent);
    border: 1px solid color-mix(in srgb, var(--oro) 55%, transparent);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.06);
    backdrop-filter: blur(8px);
  }
  .fila-superior,
  .fila-inferior {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
  }
  .herramientas-lectura a,
  .herramientas-lectura button {
    min-height: 2.6rem;
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.65rem;
    border: none;
    background: transparent;
    color: var(--marino);
    text-decoration: underline;
    text-decoration-color: var(--oro);
    text-underline-offset: 0.2em;
    cursor: pointer;
    font-size: 0.88rem;
  }
  .herramientas-lectura .posicion {
    color: var(--bruma);
    font-size: 0.84rem;
  }
  .control-velocidad {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    color: var(--marino);
    font-size: 0.88rem;
  }
  .control-velocidad select {
    min-height: 2.2rem;
    border: 1px solid color-mix(in srgb, var(--oro) 55%, transparent);
    background: var(--papel);
    color: var(--marino);
    font-size: 0.88rem;
    padding: 0.1rem 0.3rem;
  }
  #reproducir-narracion.reproduciendo {
    text-decoration-color: var(--marino);
    font-weight: 600;
  }
  header { text-align: center; margin-bottom: 2.5rem; }
  h1 { font-size: clamp(2.1rem, 6vw, 3.1rem); margin-top: 0.6rem; }
  .subtitulo {
    font-family: var(--f-display);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--bruma);
    margin-top: 0.4rem;
  }
  .aviso-contenido {
    margin: 0 0 2rem;
    padding: 0.9rem 1.1rem;
    border-left: 3px solid var(--oro);
    background: var(--papel-2);
    color: var(--tinta);
    font-size: 0.94rem;
  }
  .ayuda-enlaces {
    margin: 0 0 2rem;
    padding: 0.75rem 1.1rem;
    border-left: 3px solid var(--marino);
    background: var(--papel-2);
    color: var(--tinta);
    font-size: 0.94rem;
  }

  .texto :global(p) {
    margin-bottom: 1.15em;
    text-align: left;
    hyphens: none;
  }
  .texto :global(p.pasaje-encontrado) {
    scroll-margin-top: 9rem;
    margin-inline: -0.75rem;
    padding: 0.65rem 0.75rem;
    border-left: 3px solid var(--oro);
    background: color-mix(in srgb, var(--oro-claro) 18%, transparent);
  }
  .texto :global(mark.coincidencia-busqueda) {
    padding: 0.03em 0.16em;
    background: color-mix(in srgb, var(--oro-claro) 82%, var(--papel));
    color: var(--marino);
    font-weight: 700;
  }

  .texto :global(p:first-of-type)::first-letter {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 3.4em;
    float: left;
    line-height: 0.82;
    padding-right: 0.09em;
    color: var(--marino);
  }
  .texto :global(blockquote) {
    margin: 1.6em 1.5em;
    padding-left: 1.2em;
    border-left: 2px solid var(--oro);
    font-style: italic;
    color: color-mix(in srgb, var(--tinta) 82%, var(--bruma));
  }

  .texto :global(.referencia-documental) {
    margin: 2rem 0 2.6rem;
    padding: 1.15rem 1.25rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--oro) 58%, transparent);
    border-left: 4px solid var(--oro);
    background: var(--papel-2);
  }
  .texto :global(.referencia-etiqueta) {
    color: var(--oro-oscuro);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .texto :global(.referencia-documental h3) {
    margin: 0.35rem 0 0.45rem;
    color: var(--marino);
    font: 600 clamp(1.35rem, 4vw, 1.75rem)/1.15 var(--f-display);
  }
  .texto :global(.referencia-resumen) {
    color: var(--tinta);
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .texto :global(.referencia-fuente) {
    margin-top: 0.65rem;
    color: var(--bruma);
    font-size: 0.78rem;
  }
  .texto :global(.referencia-documental a) {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    margin-top: 0.85rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--marino);
    border-radius: 0.65rem;
    color: var(--marino);
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
  }
  .texto :global(.referencia-documental a:hover) {
    background: var(--marino);
    color: var(--papel);
  }

  .texto :global(figure.lamina) {
    margin: 2.6em auto;
    scroll-margin-top: 7.5rem;
  }
  .texto :global(figure.lamina:target img) {
    animation: destacar-foto 2.5s ease;
  }
  @keyframes destacar-foto {
    0%, 100% { box-shadow: 0 1px 8px rgb(0 0 0 / 0.07); }
    15%, 65% { box-shadow: 0 0 0 4px var(--oro); }
  }
  .texto :global(figure.lamina img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid color-mix(in srgb, var(--oro) 40%, transparent);
    padding: 6px;
    background: var(--papel-2);
    box-shadow: 0 1px 8px rgb(0 0 0 / 0.07);
  }
  .texto :global(figcaption) {
    margin-top: 0.7em;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--bruma);
    text-align: center;
    padding: 0 1rem;
  }
  .texto :global(.credito) {
    display: block;
    font-size: 0.86rem;
    opacity: 0.8;
    margin-top: 0.2em;
  }
  .texto :global(.ver-galeria) {
    display: block;
    margin: 0.6em auto 0;
    width: fit-content;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    padding: 0 0.8rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--marino);
    text-decoration: none;
    border-bottom: 1px solid var(--oro);
  }
  .texto :global(.ver-galeria:hover) { color: var(--oro); }

  .rumbos {
    margin-top: 4rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--oro) 35%, transparent);
    padding-top: 1.6rem;
  }
  .rumbos a {
    min-height: 3.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-decoration: none;
    font-family: var(--f-display);
    font-size: 1.15rem;
    max-width: 46%;
  }
  .rumbos a[rel="next"] { text-align: right; margin-left: auto; }

  .texto :global(.abre-visor) {
    display: block;
    width: 100%;
    border: none;
    padding: 0;
    background: none;
    cursor: zoom-in;
  }

  #visor {
    position: fixed;
    inset: 0;
    margin: auto;
    border: none;
    padding: 0;
    background: transparent;
    width: fit-content;
    height: fit-content;
    max-width: 94vw;
    max-height: 88vh;
    overflow: visible;
  }
  #visor::backdrop {
    background: rgb(8 14 22 / 0.93);
  }
  #visor-cuerpo {
    display: flex;
    gap: 0;
    align-items: center;
    max-width: min(72rem, 94vw);
    background: var(--noche);
    border: 1px solid color-mix(in srgb, var(--oro) 45%, transparent);
  }
  #visor-lienzo {
    position: relative;
    overflow: hidden;
    background: #000;
    touch-action: none;
    flex: 0 0 auto;
    min-width: 280px;
    min-height: 200px;
  }
  #visor-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform-origin: 0 0;
    cursor: zoom-in;
    user-select: none;
    -webkit-user-drag: none;
  }
  #visor-img.zoom-activo { cursor: grab; }
  #visor-img.arrastrando { cursor: grabbing; }

  #visor-ayuda {
    position: absolute;
    left: 0.8rem;
    bottom: 0.8rem;
    z-index: 2;
    max-width: 14rem;
    padding: 0.5rem 0.8rem;
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--papel);
    background: rgb(14 26 40 / 0.72);
    border: 1px solid color-mix(in srgb, var(--oro) 40%, transparent);
    transition: opacity 400ms ease;
    pointer-events: none;
  }
  #visor-ayuda.oculta { opacity: 0; }

  #visor-zoom {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    z-index: 2;
    display: flex;
    gap: 0.5rem;
  }
  #visor-zoom button,
  #visor-zoom a {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--oro) 55%, transparent);
    background: rgb(14 26 40 / 0.82);
    color: var(--oro-claro);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    text-decoration: none;
  }
  #visor-zoom button:hover,
  #visor-zoom a:hover { background: var(--noche); color: var(--oro); }

  #visor-ficha { align-self: stretch; }
  #visor-ficha {
    width: 19rem;
    flex-shrink: 0;
    padding: 1.6rem 1.5rem;
    background: var(--papel);
    overflow-y: auto;
    max-height: 82vh;
  }
  #visor-ficha h2 {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 1.45rem;
    color: var(--marino);
    margin: 0.2rem 0 0.8rem;
    line-height: 1.2;
  }
  #ficha-datos {
    list-style: none;
    padding: 0.8rem 0;
    margin: 0 0 0.9rem;
    border-top: 1px solid color-mix(in srgb, var(--oro) 45%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--oro) 45%, transparent);
  }
  #ficha-datos:empty, #ficha-titulo:empty { display: none; }
  #ficha-datos li {
    font-size: 0.9rem;
    line-height: 1.5;
    padding: 0.22rem 0;
  }
  #ficha-datos li strong { color: var(--marino); font-weight: 600; }
  #ficha-historia { font-size: 0.94rem; line-height: 1.6; }
  #ficha-credito { margin-top: 0.9rem; font-size: 0.85rem; color: var(--bruma); }
  #ficha-galeria { display: inline-block; margin-top: 0.7rem; font-size: 0.88rem; font-weight: 600; }
  .texto :global(.enlace-foto) {
    font: inherit;
    color: var(--marino);
    background: color-mix(in srgb, var(--oro-claro) 18%, transparent);
    border: none;
    border-radius: 0.2rem;
    padding: 0.05em 0.2em;
    margin: 0 0.05em;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--oro);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
    font-weight: 600;
  }
  .texto :global(.enlace-foto .icono-foto) {
    display: inline-block;
    margin-left: 0.2em;
    font-size: 0.85em;
    text-decoration: none;
  }
  .texto :global(.enlace-foto:hover),
  .texto :global(.enlace-foto:focus-visible) {
    color: var(--papel);
    background: var(--marino);
    text-decoration-color: var(--oro-claro);
  }
  #visor-cerrar {
    position: absolute;
    top: -0.2rem;
    right: 0;
    transform: translateY(-100%);
    background: none;
    border: none;
    color: var(--papel);
    font-size: 1.4rem;
    cursor: pointer;
    padding: 0.4rem;
  }

  @media (max-width: 860px) {
    .herramientas-lectura {
      position: static;
    }
    #visor-cuerpo { flex-direction: column; }
    #visor-ficha { width: auto; max-height: 34vh; }
    #visor-zoom button,
    #visor-zoom a { font-size: 0.95rem; }
    #visor-ayuda {
      left: 0.6rem;
      right: 0.6rem;
      bottom: auto;
      top: 0.6rem;
      max-width: none;
      font-size: 0.8rem;
    }
  }
</style>

<script>
  // Al volver desde una galería (enlace "Ver más fotografías"), llegar exactamente
  // a esa foto. No basta con el desplazamiento automático del navegador al cargar
  // la página: con textos tan largos y tipografías que cargan después, el salto
  // nativo a veces no llega o se desvía. Se reintenta varias veces por seguridad.
  if (location.hash) {
    const objetivo = document.querySelector(location.hash);
    if (objetivo) {
      const irAlObjetivo = () => objetivo.scrollIntoView({ block: 'start' });
      irAlObjetivo();
      requestAnimationFrame(irAlObjetivo);
      (document as any).fonts?.ready?.then(irAlObjetivo);
      setTimeout(irAlObjetivo, 350);
    }
  }

  const botonContinuar = document.getElementById('continuar-lectura') as HTMLButtonElement | null;
  const botonImprimir = document.getElementById('imprimir-capitulo') as HTMLButtonElement | null;
  const clavePosicion = 'memorias-posicion:' + location.pathname;

  try {
    const guardada = Number(localStorage.getItem(clavePosicion) || 0);
    if (botonContinuar && guardada > 250 && !location.hash) {
      botonContinuar.hidden = false;
      botonContinuar.addEventListener('click', () => {
        scrollTo({ top: guardada, behavior: 'smooth' });
        botonContinuar.hidden = true;
      }, { once: true });
    }
    let demora: number | undefined;
    addEventListener('scroll', () => {
      clearTimeout(demora);
      demora = window.setTimeout(() => {
        if (scrollY > 100) localStorage.setItem(clavePosicion, String(Math.round(scrollY)));
      }, 300);
    }, { passive: true });
  } catch {}
  botonImprimir?.addEventListener('click', async () => {
    const imagenes = Array.from(
      document.querySelectorAll<HTMLImageElement>('.texto img[loading="lazy"]')
    );
    await Promise.all(
      imagenes.map((img) => {
        img.loading = 'eager';
        if (img.complete) return Promise.resolve();
        return new Promise<void>((resolve) => {
          img.addEventListener('load', () => resolve(), { once: true });
          img.addEventListener('error', () => resolve(), { once: true });
        });
      })
    );
    print();
  });

  // ---- Narración persistente: sólo el botón cambia la intención de sonar/pausar ----
  const narrador = document.getElementById('narrador-global') as HTMLAudioElement | null;
  const botonNarracion = document.getElementById('reproducir-narracion') as HTMLButtonElement | null;
  const selectVelocidad = document.getElementById('velocidad-narracion') as HTMLSelectElement | null;
  const claveVelocidad = 'memorias-velocidad-narracion';
  const claveSrc = 'memorias-narracion-src';
  const claveEstado = 'memorias-narracion-estado';
  const clavePosicionNarracion = 'memorias-narracion-posicion';
  const claveSiguiente = 'memorias-narracion-siguiente';
  const claveTituloNarracion = 'memorias-narracion-titulo';

  if (narrador && botonNarracion) {
    const audioDelCapitulo = botonNarracion.dataset.audio || '';
    const rutaAudio = (valor: string) => {
      try {
        const url = new URL(valor, location.href);
        return url.pathname + url.search;
      } catch { return ''; }
    };
    const rutaActual = () => rutaAudio(narrador.currentSrc || narrador.src);
    const leerEstado = () => {
      try { return sessionStorage.getItem(claveEstado) || 'pausada'; } catch { return 'pausada'; }
    };
    const escribirSesion = (clave: string, valor: string) => {
      try { sessionStorage.setItem(clave, valor); } catch {}
    };
    const esEsteCapitulo = () => rutaActual() === rutaAudio(audioDelCapitulo);

    const actualizarBoton = () => {
      const debeSonar = esEsteCapitulo() && leerEstado() === 'sonando';
      botonNarracion.textContent = debeSonar ? '⏸ Pausar' : '▶ Escuchar';
      botonNarracion.classList.toggle('reproduciendo', debeSonar);
      botonNarracion.setAttribute('aria-pressed', String(debeSonar));
    };

    try {
      const guardada = localStorage.getItem(claveVelocidad);
      if (guardada) {
        narrador.playbackRate = Number(guardada);
        if (selectVelocidad) selectVelocidad.value = guardada;
      }
    } catch {}

    selectVelocidad?.addEventListener('change', () => {
      const v = Number(selectVelocidad.value);
      narrador.playbackRate = v;
      try { localStorage.setItem(claveVelocidad, selectVelocidad.value); } catch {}
    });

    botonNarracion.addEventListener('click', () => {
      if (esEsteCapitulo() && leerEstado() === 'sonando') {
        escribirSesion(claveEstado, 'pausada');
        narrador.pause();
        document.dispatchEvent(new CustomEvent('memorias:narracion-cambio'));
        actualizarBoton();
        return;
      }

      if (!esEsteCapitulo()) {
        narrador.pause();
        narrador.src = audioDelCapitulo;
        narrador.load();
        escribirSesion(claveSrc, audioDelCapitulo);
        escribirSesion(clavePosicionNarracion, '0');
      }
      escribirSesion(claveSiguiente, botonNarracion.dataset.siguiente || '');
      escribirSesion(claveTituloNarracion, botonNarracion.dataset.titulo || 'Capítulo en curso');
      escribirSesion(claveEstado, 'sonando');
      narrador.play().catch(() => {});
      document.dispatchEvent(new CustomEvent('memorias:narracion-cambio'));
      actualizarBoton();
    });

    narrador.addEventListener('play', actualizarBoton);
    narrador.addEventListener('pause', actualizarBoton);
    narrador.addEventListener('ended', actualizarBoton);
    document.addEventListener('memorias:narracion-estado', actualizarBoton);
    actualizarBoton();

    const parametros = new URLSearchParams(location.search);
    if (parametros.get('leer') === '1') {
      history.replaceState(null, '', location.pathname);
    }
  }
  const visor = document.getElementById('visor') as HTMLDialogElement;
  // Si llegamos desde el buscador, mostramos y marcamos el párrafo exacto.
  const parametrosBusqueda = new URLSearchParams(location.search);
  const terminoBusqueda = parametrosBusqueda.get('buscar')?.trim() || '';
  const numeroParrafo = Number(parametrosBusqueda.get('parrafo'));
  const parrafosBusqueda = Array.from(document.querySelectorAll<HTMLElement>('.texto p'));
  if (terminoBusqueda.length >= 2 && Number.isInteger(numeroParrafo) && parrafosBusqueda[numeroParrafo]) {
    const destino = parrafosBusqueda[numeroParrafo];
    destino.classList.add('pasaje-encontrado');
    destino.tabIndex = -1;

    const normalizarBusqueda = (texto: string) => texto
      .normalize('NFD')
      .replace(/\p{Diacritic}/gu, '')
      .toLocaleLowerCase('es');
    const consultaNormalizada = normalizarBusqueda(terminoBusqueda);
    const caminante = document.createTreeWalker(destino, NodeFilter.SHOW_TEXT);
    const nodos: Text[] = [];
    while (caminante.nextNode()) nodos.push(caminante.currentNode as Text);

    for (const nodo of nodos) {
      const texto = nodo.data;
      const textoNormalizado = normalizarBusqueda(texto);
      let inicio = 0;
      let coincidencia = textoNormalizado.indexOf(consultaNormalizada, inicio);
      if (coincidencia < 0) continue;
      const fragmento = document.createDocumentFragment();
      while (coincidencia >= 0) {
        fragmento.append(texto.slice(inicio, coincidencia));
        const marca = document.createElement('mark');
        marca.className = 'coincidencia-busqueda';
        marca.textContent = texto.slice(coincidencia, coincidencia + terminoBusqueda.length);
        fragmento.append(marca);
        inicio = coincidencia + terminoBusqueda.length;
        coincidencia = textoNormalizado.indexOf(consultaNormalizada, inicio);
      }
      fragmento.append(texto.slice(inicio));
      nodo.replaceWith(fragmento);
    }

    requestAnimationFrame(() => requestAnimationFrame(() => {
      destino.scrollIntoView({ block: 'center' });
      destino.focus({ preventScroll: true });
    }));
  }

  const lienzo = document.getElementById('visor-lienzo') as HTMLElement;
  const vimg = document.getElementById('visor-img') as HTMLImageElement;
  const ayuda = document.getElementById('visor-ayuda') as HTMLElement;
  const original = document.getElementById('visor-original') as HTMLAnchorElement;
  const panel = document.getElementById('visor-ficha');
  const ftitulo = document.getElementById('ficha-titulo');
  const fdatos = document.getElementById('ficha-datos');
  const fhistoria = document.getElementById('ficha-historia');
  const fcredito = document.getElementById('ficha-credito');
  const fgaleria = document.getElementById('ficha-galeria') as HTMLAnchorElement | null;

  // ---- Lupa: acercar, arrastrar, pellizcar ----
  let escala = 1;
  let tx = 0;
  let ty = 0;
  let anchoLienzo = 0;
  let altoLienzo = 0;
  const ESCALA_MIN = 1;
  const ESCALA_MAX = 5;

  function limites() {
    const movil = window.innerWidth <= 860;
    return movil
      ? { maxW: window.innerWidth * 0.94, maxH: window.innerHeight * 0.55 }
      : { maxW: Math.min(window.innerWidth * 0.6, 52 * 16), maxH: window.innerHeight * 0.82 };
  }

  function aplicar() {
    vimg.style.transform = `translate(${tx}px, ${ty}px) scale(${escala})`;
    vimg.classList.toggle('zoom-activo', escala > 1.001);
  }

  function sujetar() {
    if (escala <= 1) { tx = 0; ty = 0; return; }
    const minTx = anchoLienzo * (1 - escala);
    const minTy = altoLienzo * (1 - escala);
    tx = Math.min(0, Math.max(minTx, tx));
    ty = Math.min(0, Math.max(minTy, ty));
  }

  function fijarZoom(nuevaEscala: number, clientX: number, clientY: number) {
    nuevaEscala = Math.min(ESCALA_MAX, Math.max(ESCALA_MIN, nuevaEscala));
    const rect = lienzo.getBoundingClientRect();
    const mx = clientX - rect.left;
    const my = clientY - rect.top;
    const ux = (mx - tx) / escala;
    const uy = (my - ty) / escala;
    escala = nuevaEscala;
    tx = mx - ux * escala;
    ty = my - uy * escala;
    sujetar();
    aplicar();
  }

  function resetZoom() {
    escala = 1;
    tx = 0;
    ty = 0;
    aplicar();
  }

  function ajustarLienzo() {
    if (!vimg.naturalWidth) {
      vimg.addEventListener('load', ajustarLienzo, { once: true });
      return;
    }
    const { maxW, maxH } = limites();
    const factor = Math.min(maxW / vimg.naturalWidth, maxH / vimg.naturalHeight, 1);
    anchoLienzo = Math.max(1, Math.round(vimg.naturalWidth * factor));
    altoLienzo = Math.max(1, Math.round(vimg.naturalHeight * factor));
    lienzo.style.width = anchoLienzo + 'px';
    lienzo.style.height = altoLienzo + 'px';
    resetZoom();
    ayuda.classList.remove('oculta');
    setTimeout(() => ayuda.classList.add('oculta'), 3200);
  }

  window.addEventListener('resize', () => {
    if (visor.open) ajustarLienzo();
  });

  lienzo.addEventListener('wheel', (e) => {
    e.preventDefault();
    const factor = e.deltaY < 0 ? 1.2 : 1 / 1.2;
    fijarZoom(escala * factor, e.clientX, e.clientY);
  }, { passive: false });

  lienzo.addEventListener('dblclick', (e) => e.preventDefault());

  const punteros = new Map<number, { x: number; y: number }>();
  let inicioPinch: { dist: number; escala: number } | null = null;
  let arrastre: { x: number; y: number; tx: number; ty: number; movio: boolean } | null = null;

  lienzo.addEventListener('pointerdown', (e) => {
    if ((e.target as HTMLElement).closest('#visor-zoom')) return;
    lienzo.setPointerCapture(e.pointerId);
    punteros.set(e.pointerId, { x: e.clientX, y: e.clientY });
    ayuda.classList.add('oculta');
    if (punteros.size === 1) {
      arrastre = { x: e.clientX, y: e.clientY, tx, ty, movio: false };
    } else if (punteros.size === 2) {
      const pts = [...punteros.values()];
      inicioPinch = { dist: Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y), escala };
      arrastre = null;
    }
  });

  lienzo.addEventListener('pointermove', (e) => {
    if (!punteros.has(e.pointerId)) return;
    punteros.set(e.pointerId, { x: e.clientX, y: e.clientY });

    if (punteros.size === 2 && inicioPinch) {
      const pts = [...punteros.values()];
      const dist = Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y);
      const midX = (pts[0].x + pts[1].x) / 2;
      const midY = (pts[0].y + pts[1].y) / 2;
      fijarZoom(inicioPinch.escala * (dist / inicioPinch.dist), midX, midY);
      return;
    }

    if (arrastre) {
      const dx = e.clientX - arrastre.x;
      const dy = e.clientY - arrastre.y;
      if (Math.hypot(dx, dy) > 5) arrastre.movio = true;
      if (escala > 1) {
        tx = arrastre.tx + dx;
        ty = arrastre.ty + dy;
        sujetar();
        aplicar();
        vimg.classList.add('arrastrando');
      }
    }
  });

  function finPuntero(e: PointerEvent) {
    punteros.delete(e.pointerId);
    vimg.classList.remove('arrastrando');
    if (punteros.size < 2) inicioPinch = null;
    if (punteros.size === 0 && arrastre) {
      if (!arrastre.movio) {
        if (escala > 1.001) resetZoom();
        else fijarZoom(2.2, e.clientX, e.clientY);
      }
      arrastre = null;
    }
  }
  lienzo.addEventListener('pointerup', finPuntero);
  lienzo.addEventListener('pointercancel', finPuntero);

  document.getElementById('zoom-mas')?.addEventListener('click', () => {
    const r = lienzo.getBoundingClientRect();
    fijarZoom(escala * 1.5, r.left + r.width / 2, r.top + r.height / 2);
  });
  document.getElementById('zoom-menos')?.addEventListener('click', () => {
    const r = lienzo.getBoundingClientRect();
    fijarZoom(escala / 1.5, r.left + r.width / 2, r.top + r.height / 2);
  });
  document.getElementById('zoom-reset')?.addEventListener('click', resetZoom);

  visor?.addEventListener('close', () => {
    punteros.clear();
    inicioPinch = null;
    arrastre = null;
  });

  document.querySelectorAll('figure.lamina .abre-visor').forEach((btn) => {
    btn.addEventListener('click', () => {
      const fig = btn.closest('figure');
      const img = btn.querySelector('img');
      if (!fig || !img || !visor) return;
      vimg.src = img.src;
      vimg.alt = img.alt;
      original.href = img.src;
      ajustarLienzo();
      const cruda = fig.getAttribute('data-ficha');
      if (cruda && panel && ftitulo && fdatos && fhistoria && fcredito) {
        try {
          const ficha = JSON.parse(cruda);
          ftitulo.textContent = ficha.titulo || '';
          fdatos.innerHTML = '';
          (ficha.datos || []).forEach((d: string) => {
            const li = document.createElement('li');
            const sep = d.indexOf(':');
            if (sep > 0) {
              const b = document.createElement('strong');
              b.textContent = d.slice(0, sep) + ': ';
              li.appendChild(b);
              li.appendChild(document.createTextNode(d.slice(sep + 1).trim()));
            } else {
              li.textContent = d;
            }
            fdatos.appendChild(li);
          });
          fhistoria.textContent = ficha.historia || '';
          fcredito.textContent = ficha.credito || '';
          if (fgaleria) fgaleria.hidden = true;
          panel.hidden = false;
        } catch {
          panel.hidden = true;
        }
      } else if (panel) {
        panel.hidden = true;
      }
      visor.showModal();
    });
  });

  // Palabras del propio texto que llevan directo a una foto (sin lámina aparte).
  // Al cerrar el visor el lector queda exactamente donde estaba leyendo, porque
  // nunca se cambió de página.
  document.querySelectorAll('.enlace-foto').forEach((btn) => {
    btn.addEventListener('click', () => {
      const datos = (btn as HTMLElement).dataset;
      if (!datos.src || !visor) return;
      vimg.src = datos.src;
      vimg.alt = datos.alt || '';
      original.href = datos.src;
      ajustarLienzo();
      if (panel && ftitulo && fdatos && fhistoria && fcredito) {
        ftitulo.textContent = '';
        fdatos.innerHTML = '';
        fhistoria.textContent = datos.pie || '';
        fcredito.textContent = datos.credito || '';
        if (fgaleria) {
          if (datos.galeria) {
            fgaleria.href = datos.galeria;
            fgaleria.hidden = false;
          } else {
            fgaleria.hidden = true;
          }
        }
        panel.hidden = false;
      }
      visor.showModal();
    });
  });

  document.getElementById('visor-cerrar')?.addEventListener('click', () => visor.close());
  visor?.addEventListener('click', (e) => {
    if (e.target === visor) visor.close();
  });
</script>

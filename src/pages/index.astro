---
import Base from '../layouts/Base.astro';
import indice from '../generado/indice.json';
---
<Base claseBody="portada">
  <main>
    <section class="tapa" aria-labelledby="titulo-libro">
      <div class="marco">
        <p class="sello">Memorias escritas entre 1991 y 1995</p>
        <h1 id="titulo-libro">Memorias<br />de<br />Tomás<br />Gómez&nbsp;Arroyo</h1>
        <div class="filete-ancla" aria-hidden="true">⚓</div>
        <p class="oficio">Marino de la Armada Española</p>
        <blockquote>
          «Estoy seguro de que el ejercitar mi memoria contribuirá a revivir
          dulces recuerdos, no siempre felices, y que son como el debe y haber
          de esta cuenta corriente que es la vida de cada uno.»
        </blockquote>
        <a class="abrir" href="/capitulo/prologo">Abrir el libro</a>
      </div>
    </section>

    <section class="indice" aria-labelledby="titulo-indice">
      <h2 id="titulo-indice" class="etiqueta">Índice</h2>
      <ol>
        {indice.map((c) => (
          <li>
            <a href={`/capitulo/${c.slug}`}>
              <span class="tit">
                <span class="nombre">{c.titulo}</span>
                {c.subtitulo && <span class="sub">{c.subtitulo}</span>}
              </span>
              <span class="puntos" aria-hidden="true"></span>
              <span class="anos">{c.periodo}</span>
            </a>
          </li>
        ))}
        <li class="extra">
          <a href="/epilogo">
            <span class="tit"><span class="nombre">El resto de la travesía</span><span class="sub">epílogo documental</span></span>
            <span class="puntos" aria-hidden="true"></span>
            <span class="anos">1954 – 1996</span>
          </a>
        </li>
      </ol>

      <nav class="secciones" aria-label="Recorridos complementarios">
        <a href="/travesia">La travesía</a>
        <a href="/buques">Los buques</a>
        <a href="/sobre-esta-edicion">Sobre esta edición</a>
      </nav>
    </section>
  </main>
</Base>

<style>
  :global(body.portada) { background: var(--noche); }
  .tapa {
    min-height: min(92svh, 48rem);
    display: grid;
    place-items: center;
    padding: 1.5rem 1.2rem;
    background: radial-gradient(ellipse at 50% 30%, rgb(255 255 255 / 0.045), transparent 60%), var(--noche);
    color: var(--oro-claro);
  }
  .marco {
    max-width: 44rem;
    width: 100%;
    text-align: center;
    border: 1px solid color-mix(in srgb, var(--oro-claro) 65%, transparent);
    outline: 1px solid color-mix(in srgb, var(--oro-claro) 30%, transparent);
    outline-offset: 6px;
    padding: clamp(1.6rem, 5vh, 3.6rem) clamp(1.2rem, 5vw, 4rem);
  }
  .sello {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.27em;
    font-size: 0.9rem;
    color: var(--oro-claro);
  }
  h1 {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(2.3rem, 7vw, 4rem);
    line-height: 1.03;
    margin: 0.8rem 0 0.2rem;
    color: var(--oro-claro);
    text-wrap: balance;
  }
  .filete-ancla { color: var(--oro-claro); margin: 1rem 0; }
  .oficio {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.18em;
    font-size: 1rem;
    color: var(--papel);
  }
  blockquote {
    font-family: var(--f-display);
    font-style: italic;
    font-size: clamp(1rem, 2.4vw, 1.18rem);
    line-height: 1.55;
    color: rgb(242 236 223 / 0.92);
    max-width: 34rem;
    margin: 1.15rem auto;
  }
  .abrir {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    margin-top: 0.3rem;
    padding: 0.65rem 2.2rem;
    border: 1px solid var(--oro-claro);
    color: var(--oro-claro);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.16em;
    font-size: 1.05rem;
    text-decoration: none;
  }
  .abrir:hover { background: var(--oro-claro); color: var(--noche); }

  .indice { background: var(--papel); padding: 4.5rem 1.4rem 3rem; }
  .indice h2 { text-align: center; font-size: 1rem; margin-bottom: 2.4rem; }
  ol { list-style: none; max-width: 38rem; margin: 0 auto; }
  li + li { margin-top: 0.55rem; }
  li.extra { margin-top: 1.4rem; padding-top: 1.4rem; border-top: 1px solid color-mix(in srgb, var(--oro) 35%, transparent); }
  ol a {
    min-height: 4rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
  }
  .tit { display: flex; flex-direction: column; min-width: 0; }
  .nombre { font-family: var(--f-display); font-weight: 600; font-size: 1.3rem; color: var(--marino); }
  .sub { font-size: 0.92rem; font-style: italic; color: var(--bruma); }
  .puntos { flex: 1; border-bottom: 1px dotted var(--bruma); transform: translateY(-0.35rem); min-width: 2rem; }
  .anos { font-variant-numeric: oldstyle-nums; color: var(--bruma); font-size: 0.95rem; white-space: nowrap; }
  ol a:hover .nombre { color: var(--oro); }
  .secciones { margin-top: 3rem; display: flex; justify-content: center; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .secciones a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 1rem;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--oro) 60%, transparent);
  }

  @media (max-height: 760px) and (min-width: 620px) {
    .tapa { min-height: auto; }
    .marco { padding-top: 1.2rem; padding-bottom: 1.2rem; }
    h1 { font-size: 2.7rem; }
    blockquote { margin: 0.7rem auto; }
  }
  @media (max-width: 560px) {
    ol a { align-items: flex-start; flex-wrap: wrap; padding: 0.35rem 0; }
    .puntos { display: none; }
    .anos { width: 100%; }
  }
</style>

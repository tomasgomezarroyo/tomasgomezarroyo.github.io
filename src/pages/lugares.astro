---
import Base from '../layouts/Base.astro';
import { lugares } from '../data/lugares';
---
<Base titulo="Los lugares" descripcion="Los lugares reales de las memorias de Tomás Gómez Arroyo, reunidos en galerías fotográficas de época." conBarco={true}>
  <main class="flota">
    <header>
      <p class="etiqueta">La geografía de una vida</p>
      <h1 class="display">Los lugares</h1>
      <p class="intro">Pulse un lugar para abrir su galería, ampliar las fotografías y observar sus detalles. Son imágenes de archivo de la época o cercanas a ella, no fotografías familiares.</p>
    </header>

    <div class="fichas">
      {lugares.map((l) => (
        <article class="ficha">
          <a href={`/lugares/${l.slug}`} class={`marco-foto ${l.imagenes.length ? '' : 'sin-foto'}`} aria-label={`Abrir la galería de ${l.nombre}`}>
            {l.imagenes.length
              ? <img src={l.imagenes[0].src} alt={l.imagenes[0].alt} loading="lazy" decoding="async" />
              : <span>Fotografías<br />en preparación</span>}
            {l.imagenes.length > 0 && <span class="cantidad">{l.imagenes.length} {l.imagenes.length === 1 ? 'foto' : 'fotos'}</span>}
          </a>
          <h2><a href={`/lugares/${l.slug}`}>{l.nombre}</a></h2>
          <p class="nota">{l.descripcion}</p>
          <p class="acciones">
            <a class="boton-ficha" href={`/lugares/${l.slug}`}>{l.imagenes.length ? 'Abrir galería y lupa' : 'Ver ficha pendiente'}</a>
            {l.caps.map((cap) => <a href={`/capitulo/${cap}`}>Leer el episodio</a>)}
          </p>
        </article>
      ))}
    </div>
  </main>
</Base>

<style>
  .flota { max-width: 62rem; margin: 0 auto; padding: 5.5rem 1.4rem 3rem; }
  header { text-align: center; margin-bottom: 3rem; }
  h1 { font-size: clamp(2.1rem, 6vw, 3rem); margin-top: 0.5rem; }
  .intro { max-width: 38rem; margin: 1.2rem auto 0; color: var(--tinta); }
  .fichas { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: 2.8rem 2.2rem; }
  .ficha { display: flex; flex-direction: column; }
  .marco-foto {
    position: relative;
    display: block;
    border: 1px solid color-mix(in srgb, var(--oro) 55%, transparent);
    padding: 6px;
    background: var(--papel-2);
    box-shadow: 0 1px 8px rgb(0 0 0 / 0.08);
  }
  .cantidad {
    position: absolute;
    right: 0.65rem;
    bottom: 0.65rem;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--oro-claro);
    border-radius: 2rem;
    background: rgb(14 26 40 / 0.9);
    color: var(--papel);
    font: 600 0.78rem/1.2 var(--f-cuerpo);
  }
  .marco-foto img { display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .sin-foto {
    aspect-ratio: 3 / 2;
    display: grid;
    place-items: center;
    text-align: center;
    color: var(--bruma);
    font-family: var(--f-display);
    font-style: italic;
    background: repeating-linear-gradient(45deg, transparent 0 10px, rgb(0 0 0 / 0.025) 10px 20px), var(--papel-2);
  }
  h2 { font-family: var(--f-display); font-weight: 600; font-size: 1.55rem; margin-top: 0.9rem; }
  h2 a { text-decoration: none; }
  .nota { margin-top: 0.5rem; font-size: 0.98rem; }
  .acciones { margin-top: auto; padding-top: 0.8rem; display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; }
  .acciones a { min-height: 2.75rem; display: inline-flex; align-items: center; font-size: 0.92rem; }
  .acciones .boton-ficha {
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--marino);
    background: var(--marino);
    color: var(--papel);
    text-decoration: none;
  }
  .acciones .boton-ficha:hover { background: var(--oro); border-color: var(--oro); color: var(--papel); }
</style>

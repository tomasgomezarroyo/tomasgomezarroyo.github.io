---
import Base from '../layouts/Base.astro';
import { carrera } from '../data/carrera';

const puertos = [
  { nombre: 'Las Palmas', anos: '1921', x: 45 },
  { nombre: 'Cádiz', anos: '1938', x: 155 },
  { nombre: 'Ceuta', anos: '1938', x: 255 },
  { nombre: 'San Fernando', anos: '1939', x: 370 },
  { nombre: 'Marín', anos: '1943', x: 485 },
  { nombre: 'Portugalete', anos: '1944', x: 595 },
  { nombre: 'Cartagena', anos: '1948', x: 715 },
  { nombre: 'El Ferrol', anos: '1982', x: 825 },
];
const derrota = `M ${puertos[0].x} 78 ` + puertos.slice(1).map((p, i) => `Q ${(puertos[i].x + p.x) / 2} ${i % 2 ? 60 : 96} ${p.x} 78`).join(' ');
---
<Base titulo="La travesía" descripcion="La trayectoria de Tomás Gómez Arroyo, narrada en sus memorias y completada con hitos documentales de su carrera naval." conBarco={true}>
  <main class="travesia">
    <header>
      <p class="etiqueta">ca. 1921 – 1996</p>
      <h1 class="display">La travesía</h1>
      <p class="intro">De marinero voluntario a Vicealmirante de la Armada. Los años de 1938 a 1954 los cuenta él mismo; los hitos posteriores proceden de documentación oficial y del archivo familiar, y todavía no forman una biografía completa.</p>
    </header>

    <figure class="derrota" aria-labelledby="pie-derrota">
      <div class="mapa-puertos">
        <svg viewBox="0 0 870 120" role="img" aria-label="Puertos principales de la travesía, en orden cronológico">
          <path d={derrota} fill="none" stroke="var(--oro)" stroke-width="1.4" stroke-dasharray="1 7" stroke-linecap="round" />
          {puertos.map((p) => (
            <>
              <circle cx={p.x} cy="78" r="3.2" fill="var(--marino)" />
              <text x={p.x} y="56" text-anchor="middle" class="puerto">{p.nombre}</text>
              <text x={p.x} y="106" text-anchor="middle" class="anosvg">{p.anos}</text>
            </>
          ))}
        </svg>
      </div>
      <figcaption id="pie-derrota">Recorrido geográfico resumido. En pantallas pequeñas, la cronología inferior contiene la misma información esencial sin desplazamiento lateral.</figcaption>
    </figure>

    <ol class="linea">
      {carrera.map((h) => (
        <li>
          <span class="ano">{h.ano}</span>
          <span class="que">
            {h.texto}
            {h.referencia && <span class="referencia">{h.referencia}</span>}
            {h.cap && <a class="ircap" href={`/capitulo/${h.cap}`}>{h.cap === 'prologo' ? 'Leer el prólogo' : `Leer el episodio de ${h.ano}`}</a>}
          </span>
        </li>
      ))}
    </ol>
  </main>
</Base>

<style>
  .travesia { max-width: 46rem; margin: 0 auto; padding: 5.5rem 1.4rem 3rem; }
  header { text-align: center; margin-bottom: 2.8rem; }
  h1 { font-size: clamp(2.1rem, 6vw, 3rem); margin-top: 0.5rem; }
  .intro { max-width: 36rem; margin: 1.2rem auto 0; color: var(--tinta); }
  .derrota { margin: 2.5rem -0.5rem 3.2rem; }
  .mapa-puertos { overflow-x: auto; padding-bottom: 0.5rem; }
  .derrota svg { min-width: 700px; width: 100%; height: auto; display: block; }
  .derrota figcaption { font-size: 0.9rem; line-height: 1.5; color: var(--bruma); text-align: center; }
  .puerto { font-family: var(--f-display); font-size: 19px; font-weight: 600; fill: var(--marino); }
  .anosvg { font-size: 16px; fill: var(--bruma); }
  .linea { list-style: none; border-left: 1px solid color-mix(in srgb, var(--oro) 55%, transparent); padding-left: 1.6rem; margin-left: 0.4rem; }
  .linea li { position: relative; margin-bottom: 1.5rem; display: grid; grid-template-columns: 3.5rem 1fr; gap: 0.9rem; }
  .linea li::before { content: ''; position: absolute; left: calc(-1.6rem - 4px); top: 0.55em; width: 7px; height: 7px; border-radius: 50%; background: var(--oro); }
  .ano { font-family: var(--f-display); font-weight: 700; font-size: 1.15rem; color: var(--marino); }
  .que { color: var(--tinta); }
  .referencia { display: block; margin-top: 0.2rem; font-size: 0.88rem; line-height: 1.45; color: var(--bruma); }
  .ircap { min-height: 2.75rem; margin-top: 0.25rem; display: inline-flex; align-items: center; font-variant-caps: all-small-caps; letter-spacing: 0.08em; font-size: 0.92rem; }
  @media (max-width: 620px) {
    .mapa-puertos { display: none; }
    .derrota { margin-top: 1.4rem; margin-bottom: 2.4rem; }
    .linea li { grid-template-columns: 3.2rem 1fr; }
  }
</style>
